def repo_root() -> Path:
    return Path(__file__).resolve().parents[2]


def load_json(path: Path) -> dict[str, Any]:
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def intrinsic_sources(opentileas_repo: Path) -> list[Path]:
    candidates = [
        opentileas_repo / "include" / "Dialect" / "CCE" / "IR" / "CCEIntrinsicMap.td",
        opentileas_repo / "include" / "Target" / "Npu" / "IntrinsicsNPU.td",
    ]
    return [path for path in candidates if path.is_file()]


def discover_intrinsics(opentileas_repo: Path) -> dict[str, dict[str, Any]]:
    inventory: dict[str, dict[str, Any]] = {}
    for path in intrinsic_sources(opentileas_repo):
        text = path.read_text(encoding="utf-8", errors="ignore")
        for match in re.finditer(r'"(llvm\.hivm\.[^"]+)"', text):
            name = "@" + match.group(1)
            entry = inventory.setdefault(
                name,
                {
                    "intrinsic": name,
                    "category": categorize(name),
                    "priority": priority(name),
                    "sources": [],
                    "model": "supported" if name in MODEL_SUPPORTED else "unsupported",
                    "suite": "missing",
                },
            )
            rel = str(path.relative_to(opentileas_repo))
            if rel not in entry["sources"]:
                entry["sources"].append(rel)
    return inventory


def categorize(name: str) -> str:
    lowered = name.lower()
    if any(token in lowered for token in ("mmad", "l0a", "l0b", "l0c", "fix.l0c", "load.l1.to")):
        return "cube-matmul"
    if any(token in lowered for token in ("mov.", "get.buf", "rls.buf")):
        return "dma"
    if any(token in lowered for token in ("flag", "barrier", "mem.bar", "sbitset", "ctrl", "intra.block")):
        return "sync"
    if any(token in lowered for token in ("pld", "plt.", "pst", "pset", "sprclr", "init.vector.align")):
        return "predicate-state"
    if any(token in lowered for token in ("vlds", "vldu", "vldas", "vsts", "vstus", "vstur", "vstar", "vstas", "vsldb")):
        return "load-store"
    if any(token in lowered for token in ("vcvt", "vtrc", "vmulscvt")):
        return "convert"
    if any(token in lowered for token in ("set.channel", "set.loop")):
        return "sync"
    if "gather" in lowered or "scatter" in lowered:
        return "gather-scatter"
    if "vsel" in lowered or "cmp" in lowered or "pintlv" in lowered or "pmov" in lowered:
        return "predicate-select"
    if "vcadd" in lowered or "vcmax" in lowered or "vcmin" in lowered:
        return "reduction"
    if any(token in lowered for token in ("vadds", "vmuls", "vmaxs", "vmins")):
        return "scalar-vector"
    if any(token in lowered for token in ("vabs", "vneg", "vsqrt", "vrsqrt", "vrec", "vexp", "vln", "vrelu", "vlrelu", "vnot")):
        return "unary"
    if any(token in lowered for token in ("vaxpy", "vmadd")):
        return "fused-vector"
    if any(token in lowered for token in ("vadd", "vsub", "vmul", "vdiv", "vmax", "vmin", "vand")):
        return "binary"
    if "vdups" in lowered or "vbr" in lowered:
        return "broadcast"
    if any(token in lowered for token in ("sort", "vbs", "vms4", "sqz", "vmrg", "unpack", "pack")):
        return "rearrange-sort"
    return "unknown"


def priority(name: str) -> str:
    lowered = name.lower()
    if ".v64f32" in lowered and any(
        token in lowered
        for token in (
            "vadd",
            "vsub",
            "vmul",
            "vdiv",
            "vmax",
            "vmin",
            "vabs",
            "vneg",
            "vsqrt",
            "vrec",
            "vexp",
            "vdups",
            "vadds",
            "vmuls",
            "vmaxs",
            "vmins",
            "vcadd",
            "vsel",
        )
    ):
        return "P0"
    if any(token in lowered for token in ("mmad", "l0a", "l0b", "l0c", "fix.l0c", "load.l1.to")):
        return "P1"
    if ".v64f32" in lowered or ".v128f16" in lowered or ".v128bf16" in lowered:
        return "P1"
    return "P2"


def suite_intrinsics(suite: dict[str, Any]) -> set[str]:
    covered: set[str] = set()
    for section in ("asc_cases", "lowered_cases", "simulator_cases", "external_cases"):
        for case in suite.get(section, []):
            covered.update(case_intrinsics(case, include_suite_op=section != "external_cases"))
            covered.update(case_kernel_intrinsics(case, section))
    return covered


def case_intrinsics(case: dict[str, Any], *, include_suite_op: bool = True) -> set[str]:
    names = {
        name if name.startswith("@") else "@" + name
        for name in case.get("intrinsics", [])
    }
    if not include_suite_op or case.get("suite_op") is False:
        return names
    op = case.get("op", "vadd")
    if op == "vrec" and case.get("decompose_vrec"):
        return names
    if op in SUITE_OP_INTRINSICS:
        entry = SUITE_OP_INTRINSICS[op]
        if isinstance(entry, dict):
            mode = case.get("mode", "x")
            if mode in entry:
                names.add(entry[mode])
        else:
            names.add(entry)
    return names


def case_kernel_intrinsics(case: dict[str, Any], section: str) -> set[str]:
    if case.get("kernel_intrinsics") is False:
        return set()
    if section == "asc_cases":
        return set(ASC_IR_KERNEL_INTRINSICS) if case.get("ir") else set()
    if section in ("lowered_cases", "simulator_cases") and "mlir" in case:
        return set(OPENTILE_VECTOR_KERNEL_INTRINSICS)
    return set()


def suite_evidence(suite: dict[str, Any]) -> dict[str, dict[str, list[str]]]:
    evidence: dict[str, dict[str, list[str]]] = {}
    sections = (
        ("asc_cases", "asc"),
        ("lowered_cases", "asc"),
        ("simulator_cases", "simulator"),
    )
    for section, domain in sections:
        for case in suite.get(section, []):
            status_key = "expect_simulator_status" if domain == "simulator" else "expect_asc_status"
            expected = case.get(status_key, "pass")
            outcome = "pass" if expected == "pass" else "error"
            bucket = f"{domain}_{outcome}"
            names = case_intrinsics(case) | case_kernel_intrinsics(case, section)
            for name in names:
                item = evidence.setdefault(
                    name,
                    {
                        "asc_pass": [],
                        "asc_error": [],
                        "simulator_pass": [],
                        "simulator_error": [],
                    },
                )
                item[bucket].append(case["name"])
    for case in suite.get("external_cases", []):
        names = case_intrinsics(case, include_suite_op=False)
        for domain, status_key in (
            ("asc", "expect_asc_status"),
            ("simulator", "expect_simulator_status"),
        ):
            expected = case.get(status_key)
            if expected is None:
                continue
            outcome = "pass" if expected == "pass" else "error"
            bucket = f"{domain}_{outcome}"
            for name in names:
                item = evidence.setdefault(
                    name,
                    {
                        "asc_pass": [],
                        "asc_error": [],
                        "simulator_pass": [],
                        "simulator_error": [],
                    },
                )
                item[bucket].append(case["name"])
    return evidence


def compact_evidence(evidence: dict[str, list[str]]) -> dict[str, Any]:
    compact: dict[str, Any] = {}
    for bucket, cases in evidence.items():
        if cases:
            compact[bucket] = {"count": len(cases), "cases": cases[:8]}
    return compact


def oracle_status(model: str, evidence: dict[str, list[str]] | None) -> str:
    if not evidence:
        return "missing"
    asc_pass = bool(evidence["asc_pass"])
    asc_error = bool(evidence["asc_error"])
    simulator_pass = bool(evidence["simulator_pass"])
    simulator_error = bool(evidence["simulator_error"])
    if model == "supported":
        if asc_pass and simulator_pass:
            return "pass-oracle"
        if asc_pass:
            return "asc-pass-only"
        return "covered"
    if asc_pass and simulator_error:
        return "asc-pass-simulator-error"
    if asc_error and simulator_error:
        return "fail-closed"
    if asc_error and simulator_pass:
        return "model-gap"
    if asc_error:
        return "asc-error-only"
    if simulator_error:
        return "simulator-error-only"
    return "covered-unsupported"


def report(inventory: dict[str, dict[str, Any]]) -> dict[str, Any]:
    items = sorted(inventory.values(), key=lambda item: (item["priority"], item["category"], item["intrinsic"]))
    summary: dict[str, Any] = {
        "total": len(items),
        "supported": sum(1 for item in items if item["model"] == "supported"),
        "unsupported": sum(1 for item in items if item["model"] != "supported"),
        "oracle_covered": sum(1 for item in items if item.get("oracle") not in (None, "missing")),
        "behavior_oracle": sum(1 for item in items if item.get("oracle") == "pass-oracle"),
        "fail_closed": sum(1 for item in items if item.get("oracle") == "fail-closed"),
        "model_gap": sum(1 for item in items if item.get("oracle") == "model-gap"),
        "by_priority": {},
        "by_category": {},
        "by_oracle": {},
    }
    for item in items:
        summary["by_priority"][item["priority"]] = summary["by_priority"].get(item["priority"], 0) + 1
        summary["by_category"][item["category"]] = summary["by_category"].get(item["category"], 0) + 1
        summary["by_oracle"][item["oracle"]] = summary["by_oracle"].get(item["oracle"], 0) + 1
    return {"summary": summary, "intrinsics": items}


def main(argv: list[str]) -> int:
    root = repo_root()
    default_suite = root / "examples" / "davsim" / "vadd" / "oracle" / "vadd_oracle_suite.json"
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--opentileas-repo", type=Path, default=root.parent / "OpenTileAS")
    parser.add_argument("--suite", type=Path, default=default_suite)
    parser.add_argument("--json", type=Path, help="write full JSON report")
    parser.add_argument("--fail-on-p0-unsupported", action="store_true")
    parser.add_argument(
        "--fail-on-p0-missing-oracle",
        action="store_true",
        help="fail if a P0 intrinsic has no ASC/simulator oracle evidence",
    )
    parser.add_argument(
        "--fail-on-supported-missing-oracle",
        action="store_true",
        help="fail if a model-supported intrinsic lacks a passing ASC+simulator oracle",
    )
    args = parser.parse_args(argv)

    inventory = discover_intrinsics(args.opentileas_repo.resolve())
    suite = load_json(args.suite.resolve())
    covered = suite_intrinsics(suite)
    evidence = suite_evidence(suite)
    for name in covered:
        if name in inventory:
            inventory[name]["suite"] = "covered"
    for name, item in inventory.items():
        item_evidence = evidence.get(name)
        item["oracle"] = oracle_status(item["model"], item_evidence)
        item["evidence"] = compact_evidence(item_evidence) if item_evidence else {}
    data = report(inventory)
    summary = data["summary"]
    print(
        "intrinsic coverage: "
        f"{summary['supported']}/{summary['total']} model-supported, "
        f"{summary['unsupported']} unsupported, "
        f"{summary['oracle_covered']} oracle-covered, "
        f"{summary['behavior_oracle']} behavior, "
        f"{summary['fail_closed']} fail-closed, "
        f"{summary['model_gap']} model-gap"
    )
    print(f"by priority: {summary['by_priority']}")
    print(f"by category: {summary['by_category']}")
    print(f"by oracle: {summary['by_oracle']}")
    p0_missing = [
        item for item in data["intrinsics"]
        if item["priority"] == "P0" and item["model"] != "supported"
    ]
    p0_missing_oracle = [
        item for item in data["intrinsics"]
        if item["priority"] == "P0" and item["oracle"] == "missing"
    ]
    supported_missing_oracle = [
        item for item in data["intrinsics"]
        if item["model"] == "supported" and item["oracle"] != "pass-oracle"
    ]
    if p0_missing:
        print("[P0 unsupported]")
        for item in p0_missing[:80]:
            print(f"  {item['intrinsic']} ({item['category']}, {item['oracle']})")
        if len(p0_missing) > 80:
            print(f"  ... {len(p0_missing) - 80} more")
    if p0_missing_oracle:
        print("[P0 missing oracle]")
        for item in p0_missing_oracle[:80]:
            print(f"  {item['intrinsic']} ({item['category']})")
        if len(p0_missing_oracle) > 80:
            print(f"  ... {len(p0_missing_oracle) - 80} more")
    if supported_missing_oracle:
        print("[supported missing pass oracle]")
        for item in supported_missing_oracle[:80]:
            print(f"  {item['intrinsic']} ({item['category']}, {item['oracle']})")
        if len(supported_missing_oracle) > 80:
            print(f"  ... {len(supported_missing_oracle) - 80} more")
    if args.json:
        args.json.resolve().write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    if args.fail_on_p0_unsupported and p0_missing:
        return 1
    if args.fail_on_p0_missing_oracle and p0_missing_oracle:
        return 1
    if args.fail_on_supported_missing_oracle and supported_missing_oracle:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
