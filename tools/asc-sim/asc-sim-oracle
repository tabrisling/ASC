def load_json(path: Path) -> dict[str, Any]:
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def write_json(path: Path, data: dict[str, Any]) -> None:
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def repo_root() -> Path:
    return Path(__file__).resolve().parents[2]


def deep_merge(dst: dict[str, Any], src: dict[str, Any]) -> dict[str, Any]:
    for key, value in src.items():
        if isinstance(value, dict) and isinstance(dst.get(key), dict):
            deep_merge(dst[key], value)
        else:
            dst[key] = value
    return dst


def run_command(cmd: list[str], cwd: Path | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, cwd=cwd, text=True, capture_output=True, check=False)


def classify_asc_status(returncode: int) -> str:
    if returncode == 0:
        return "pass"
    if returncode == 1:
        return "check_failed"
    return "error"


def classify_simulator_status(result: subprocess.CompletedProcess[str]) -> tuple[str, str | None]:
    if result.returncode != 0:
        return "error", None
    local_run = parse_local_run(result.stdout)
    if not local_run:
        return "pass", None
    log = Path(local_run) / "remote" / "logs" / "simulator.log"
    if not log.is_file():
        return "pass", None
    text = log.read_text(encoding="utf-8", errors="ignore")
    abs_ratios = [
        float(match.group(1))
        for match in re.finditer(r"abs_pass_ratio\([^)]*\):\s+([0-9.]+)%", text)
    ]
    rel_ratios = [
        float(match.group(1))
        for match in re.finditer(r"rel_pass_ratio\([^)]*\):\s+([0-9.]+)%", text)
    ]
    abs_failed = abs_ratios and any(ratio < 100.0 for ratio in abs_ratios)
    rel_failed = rel_ratios and any(ratio < 100.0 for ratio in rel_ratios)
    if abs_failed or rel_failed:
        return "check_failed", tail(text)
    return "pass", None


def apply_replacements(text: str, replacements: list[dict[str, str]]) -> str:
    for item in replacements:
        old = item["old"]
        new = item.get("new", "")
        if old not in text:
            raise RuntimeError(f"replacement source not found: {old!r}")
        text = text.replace(old, new, 1)
    return text


def run_asc_ir_case(
    case_cfg: dict[str, Any],
    suite_dir: Path,
    asc_sim: Path,
    tmp_dir: Path,
) -> dict[str, Any]:
    ir_path = (suite_dir / case_cfg["ir"]).resolve()
    case_path = (suite_dir / case_cfg["case"]).resolve()
    ir_text = apply_replacements(
        ir_path.read_text(encoding="utf-8"),
        case_cfg.get("replacements", []),
    )
    case_json = copy.deepcopy(load_json(case_path))
    deep_merge(case_json, case_cfg.get("case_overrides", {}))
    generated = case_cfg.get("generated")
    if generated:
        apply_generated_asc_case(case_json, generated)
    op = case_cfg.get("op", "vadd")
    mode = case_cfg.get("mode", "x")
    if case_cfg.get("op") or mode != "x":
        ir_text = patch_vector_compute_ir(
            case_cfg["name"],
            ir_text,
            op,
            lowered=False,
            mode=mode,
            part=int(case_cfg.get("part", 0)),
            extract=int(case_cfg.get("extract", 0)),
            decompose_vrec=bool(case_cfg.get("decompose_vrec", False)),
        )
        apply_vector_op_case(
            case_json,
            op,
            float(case_cfg.get("scalar", case_cfg_scalar_default(op))),
            mode,
            int(case_cfg.get("mask_pattern", 0)),
            int(case_cfg.get("extract", 0)),
        )
    ir_text = patch_mask_patterns(ir_text, case_cfg)

    work_ir = tmp_dir / f"{case_cfg['name']}.ll"
    work_case = tmp_dir / f"{case_cfg['name']}.case.json"
    work_ir.write_text(ir_text, encoding="utf-8")
    write_json(work_case, case_json)

    result = run_command([str(asc_sim), str(work_ir), "--case", str(work_case)])
    status = classify_asc_status(result.returncode)
    expected = case_cfg.get("expect_asc_status", "pass")
    return {
        "name": case_cfg["name"],
        "kind": "asc-ir",
        "oracle_key": oracle_key(case_cfg),
        "status": status,
        "expected": expected,
        "ok": status == expected,
        "returncode": result.returncode,
        "stderr_tail": tail(result.stderr),
        "stdout_tail": tail(result.stdout),
    }


def generated_vector_case(
    op: str,
    mode: str,
    n_elements: int,
    allocated_elements: int,
    ub_size_bytes: int,
    dma_bytes: int,
    mask_pattern: int = 0,
    extract: int = 0,
) -> dict[str, Any]:
    x, y = generated_inputs(op, allocated_elements)
    scalar = float(case_cfg_scalar_default(op))
    active = max(0, min(n_elements, allocated_elements))
    mask = pattern_to_mask(mask_pattern)
    golden = [0.0] * allocated_elements
    if op == "vmull":
        if extract not in (0, 1):
            raise RuntimeError(f"unsupported vmull extract index {extract}")
        source = x if extract == 0 else y
        for idx in range(active):
            golden[idx] = f32(source[idx] * source[idx])
        return {
            "entry": "add_kernel",
            "arguments": {"%0": "x", "%1": "y", "%2": "output"},
            "scalars": {"%3": n_elements},
            "buffers": {
                "x": {"space": "gm", "dtype": "f32", "values": x},
                "y": {"space": "gm", "dtype": "f32", "values": y},
                "output": {"space": "gm", "dtype": "f32", "size": allocated_elements},
            },
            "ub_size_bytes": ub_size_bytes,
            "dma_bytes": dma_bytes,
            "checks": [{"buffer": "output", "golden": golden, "atol": 0, "rtol": 0}],
        }
    if op in ("vcadd", "vcmax", "vcmin"):
        for group_start in range(0, active, 64):
            group_end = min(group_start + 64, active)
            values = []
            for idx in range(group_start, group_end):
                lane = idx % 64
                if mask[lane]:
                    values.append(x[idx])
            if op == "vcadd":
                result = 0.0
                for value in values:
                    result = f32(result + value)
            elif op == "vcmax":
                result = f32(max(values))
            else:
                result = f32(min(values))
            golden[group_start] = result
        return {
            "entry": "add_kernel",
            "arguments": {"%0": "x", "%1": "y", "%2": "output"},
            "scalars": {"%3": n_elements},
            "buffers": {
                "x": {"space": "gm", "dtype": "f32", "values": x},
                "y": {"space": "gm", "dtype": "f32", "values": y},
                "output": {"space": "gm", "dtype": "f32", "size": allocated_elements},
            },
            "ub_size_bytes": ub_size_bytes,
            "dma_bytes": dma_bytes,
            "checks": [{"buffer": "output", "golden": golden, "atol": 0, "rtol": 0}],
        }
    for idx in range(active):
        lane = idx % 64
        if op == "vsel":
            golden[idx] = f32(x[idx] if mask[lane] else y[idx])
        elif op == "vexpdif":
            if not mask[lane]:
                golden[idx] = 0.0
            else:
                golden[idx] = eval_vector_op(op, x[idx], y[idx], scalar)
        elif mask[lane]:
            golden[idx] = eval_vector_op(op, x[idx], y[idx], scalar)
        elif mode == "m":
            golden[idx] = f32(x[idx])
        elif mode == "z":
            golden[idx] = 0.0
    return {
        "entry": "add_kernel",
        "arguments": {"%0": "x", "%1": "y", "%2": "output"},
        "scalars": {"%3": n_elements},
        "buffers": {
            "x": {"space": "gm", "dtype": "f32", "values": x},
            "y": {"space": "gm", "dtype": "f32", "values": y},
            "output": {"space": "gm", "dtype": "f32", "size": allocated_elements},
        },
        "ub_size_bytes": ub_size_bytes,
        "dma_bytes": dma_bytes,
        "checks": [
            {
                "buffer": "output",
                "golden": golden,
                "atol": 1e-5 if op == "vexpdif" else 0,
                "rtol": 1e-5 if op == "vexpdif" else 0,
            }
        ],
    }


def f32(value: float) -> float:
    if math.isnan(value):
        return float("nan")
    try:
        return struct.unpack("f", struct.pack("f", value))[0]
    except OverflowError:
        return math.copysign(float("inf"), value)


def f16(value: float) -> float:
    if math.isnan(value):
        return float("nan")
    try:
        return struct.unpack("e", struct.pack("e", value))[0]
    except OverflowError:
        return math.copysign(float("inf"), value)


def f32_div(a: float, b: float) -> float:
    if math.isnan(a) or math.isnan(b):
        return float("nan")
    if b == 0.0:
        if a == 0.0:
            return float("nan")
        return math.copysign(float("inf"), a * b)
    return f32(a / b)


def f32_sqrt(value: float) -> float:
    if math.isnan(value):
        return float("nan")
    if value < 0.0:
        return float("nan")
    return f32(math.sqrt(value))


def f32_rsqrt(value: float) -> float:
    root = f32_sqrt(value)
    return f32_div(1.0, root)


def f32_ln(value: float) -> float:
    if math.isnan(value):
        return float("nan")
    if value < 0.0:
        return float("nan")
    if value == 0.0:
        return float("-inf")
    return f32(math.log(value))


def f32_exp(value: float) -> float:
    if math.isnan(value):
        return float("nan")
    try:
        return f32(math.exp(value))
    except OverflowError:
        return float("inf")


def case_cfg_scalar_default(op: str) -> float:
    if op == "vdups":
        return 3.5
    if op in VECTOR_SCALAR_INTRINSICS:
        return 2.0
    return 0.0


def pattern_to_mask(pattern: int) -> list[bool]:
    active_by_pattern = {
        0: 64,
        5: 4,
        6: 8,
        7: 16,
        8: 32,
        9: 64,
    }
    if pattern not in active_by_pattern:
        raise RuntimeError(f"unsupported pset pattern {pattern}")
    active = active_by_pattern[pattern]
    return [idx < active for idx in range(64)]


def generated_inputs(op: str, allocated_elements: int) -> tuple[list[float], list[float]]:
    if op in ("vsqrt", "vrsqrt", "vrec", "vln"):
        x = [1.0 + float(i) * 0.125 for i in range(allocated_elements)]
    elif op in ("vexp", "vexpdif"):
        x = [float((i % 17) - 8) * 0.125 for i in range(allocated_elements)]
        y = [float((i % 11) - 5) * 0.0625 for i in range(allocated_elements)]
        return x, y
    else:
        x = [float(i) * 0.5 for i in range(allocated_elements)]
    y = [7.0 - float(i) * 0.25 for i in range(allocated_elements)]
    if op == "vdiv":
        y = [1.0 + float(i % 31) * 0.25 for i in range(allocated_elements)]
    return x, y


def eval_vector_op(op: str, a: float, b: float, scalar: float) -> float:
    if op == "vadd":
        return f32(a + b)
    if op == "vsub":
        return f32(a - b)
    if op == "vmul":
        return f32(a * b)
    if op == "vdiv":
        return f32_div(a, b)
    if op == "vmax":
        return f32(max(a, b))
    if op == "vmin":
        return f32(min(a, b))
    if op == "vsel":
        return f32(a)
    if op == "vabs":
        return f32(abs(a))
    if op == "vneg":
        return f32(-a)
    if op == "vrelu":
        return f32(max(a, 0.0))
    if op == "vsqrt":
        return f32_sqrt(a)
    if op == "vrsqrt":
        return f32_rsqrt(a)
    if op == "vrec":
        return f32_div(1.0, a)
    if op == "vexp":
        return f32_exp(a)
    if op == "vln":
        return f32_ln(a)
    if op == "vexpdif":
        return f32_exp(f32(a - b))
    if op == "vadds":
        return f32(a + scalar)
    if op == "vmuls":
        return f32(a * scalar)
    if op == "vmaxs":
        return f32(max(a, scalar))
    if op == "vmins":
        return f32(min(a, scalar))
    if op == "vdups":
        return f32(scalar)
    if op == "vcadd":
        return f32(a)
    if op in ("vcmax", "vcmin"):
        return f32(a)
    raise RuntimeError(f"unsupported vector op: {op}")


def apply_vector_op_case(
    case_json: dict[str, Any],
    op: str,
    scalar: float,
    mode: str = "x",
    mask_pattern: int = 0,
    extract: int = 0,
) -> None:
    a = [float(x) for x in case_json["buffers"]["a"]["values"]]
    b = [float(x) for x in case_json["buffers"]["b"]["values"]]
    mask = pattern_to_mask(mask_pattern)
    golden = []
    if op == "vmull":
        source = a if extract == 0 else b
        for idx, x in enumerate(source):
            if mask[idx % 64]:
                golden.append(f32(x * x))
            else:
                golden.append(0.0)
        case_json["checks"][0]["golden"] = golden
        return
    if op in ("vcadd", "vcmax", "vcmin"):
        for group_start in range(0, len(a), 64):
            group = a[group_start : group_start + 64]
            values = []
            for lane, x in enumerate(group):
                if mask[lane]:
                    values.append(x)
            if op == "vcadd":
                result = 0.0
                for value in values:
                    result = f32(result + value)
            elif op == "vcmax":
                result = f32(max(values))
            else:
                result = f32(min(values))
            golden.extend([result] + [0.0] * (len(group) - 1))
        case_json["checks"][0]["golden"] = golden
        return
    for idx, (x, y) in enumerate(zip(a, b)):
        if op == "vsel":
            golden.append(f32(x if mask[idx % 64] else y))
        elif op == "vexpdif":
            if mask[idx % 64]:
                golden.append(eval_vector_op(op, x, y, scalar))
            else:
                golden.append(0.0)
        elif mask[idx % 64]:
            golden.append(eval_vector_op(op, x, y, scalar))
        elif mode == "m":
            golden.append(f32(x))
        elif mode == "z":
            golden.append(0.0)
        else:
            golden.append(0.0)
    case_json["checks"][0]["golden"] = golden


def op_intrinsic(op: str, mode: str = "x") -> str:
    if (op, mode) in VECTOR_BINARY_MODE_INTRINSICS:
        return VECTOR_BINARY_MODE_INTRINSICS[(op, mode)]
    if (op, mode) in VECTOR_VMULL_INTRINSICS:
        return VECTOR_VMULL_INTRINSICS[(op, mode)]
    if (op, mode) in VECTOR_SCALAR_MODE_INTRINSICS:
        return VECTOR_SCALAR_MODE_INTRINSICS[(op, mode)]
    if (op, mode) in VECTOR_REDUCTION_MODE_INTRINSICS:
        return VECTOR_REDUCTION_MODE_INTRINSICS[(op, mode)]
    if mode != "x":
        raise RuntimeError(f"unsupported vector op/mode: {op}.{mode}")
    for table in (
        VECTOR_BINARY_INTRINSICS,
        VECTOR_UNARY_INTRINSICS,
        VECTOR_SCALAR_INTRINSICS,
        VECTOR_DUP_INTRINSICS,
        VECTOR_SELECT_INTRINSICS,
        VECTOR_DIFF_EXP_INTRINSICS,
        VECTOR_REDUCTION_INTRINSICS,
    ):
        if op in table:
            return table[op]
    raise RuntimeError(f"unsupported vector op: {op}")


def patch_vector_compute_ir(
    case_name: str,
    ir_text: str,
    op: str,
    lowered: bool,
    mode: str = "x",
    part: int = 0,
    extract: int = 0,
    decompose_vrec: bool = False,
) -> str:
    if op == "vadd" and mode == "x":
        return ir_text
    source = VECTOR_BINARY_INTRINSICS["vadd"] if lowered else "@llvm.hivm.vadd.v64f32.x"
    target = op_intrinsic(op, mode)
    call_pattern = re.compile(
        rf"(?P<lhs>%[-A-Za-z0-9_.$]+)\s*=\s*call\s+<64 x float>\s+{re.escape(source)}"
        r"\(<64 x float>\s+(?P<a>%[-A-Za-z0-9_.$]+),\s+<64 x float>\s+(?P<b>%[-A-Za-z0-9_.$]+),\s+<256 x i1>\s+(?P<mask>%[-A-Za-z0-9_.$]+)\)"
    )

    def replace_call(match: re.Match[str]) -> str:
        lhs = match.group("lhs")
        a = match.group("a")
        b = match.group("b")
        mask = match.group("mask")
        if op in VECTOR_BINARY_INTRINSICS or op in VECTOR_SELECT_INTRINSICS:
            return f"{lhs} = call <64 x float> {target}(<64 x float> {a}, <64 x float> {b}, <256 x i1> {mask})"
        if op in VECTOR_DIFF_EXP_INTRINSICS:
            return f"{lhs} = call <64 x float> {target}(<64 x float> {a}, <64 x float> {b}, <256 x i1> {mask}, i32 {part})"
        if op in VECTOR_REDUCTION_INTRINSICS:
            return f"{lhs} = call <64 x float> {target}(<64 x float> {a}, <256 x i1> {mask})"
        if op == "vrec" and decompose_vrec:
            suffix = re.sub(r"[^A-Za-z0-9_]+", "_", lhs.lstrip("%")).strip("_") or "result"
            ones_name = f"%asc_vrec_one_{suffix}"
            return "\n".join(
                [
                    f"{ones_name} = call <64 x float> @llvm.hivm.vbr.f32.v300(float 1.000000e+00)",
                    f"{lhs} = call <64 x float> @llvm.hivm.vdiv.s.x.v64f32(<64 x float> {ones_name}, <64 x float> {a}, <256 x i1> {mask})",
                ]
            )
        if op == "vmull":
            shuffle_mask = ", ".join(f"i32 {idx}" for idx in range(128))
            suffix = re.sub(r"[^A-Za-z0-9_]+", "_", lhs.lstrip("%")).strip("_") or "result"
            vec_name = f"%asc_vmull_vec_{suffix}"
            agg_name = f"%asc_vmull_agg_{suffix}"
            pass_thru = a if mode == "m" else "undef"
            return "\n".join(
                [
                    f"{vec_name} = shufflevector <64 x float> {a}, <64 x float> {b}, <128 x i32> <{shuffle_mask}>",
                    f"{agg_name} = call {{ <64 x float>, <64 x float> }} {target}(<128 x float> {vec_name}, <128 x float> {vec_name}, <256 x i1> {mask}, <64 x float> {pass_thru})",
                    f"{lhs} = extractvalue {{ <64 x float>, <64 x float> }} {agg_name}, {extract}",
                ]
            )
        if op in VECTOR_UNARY_INTRINSICS:
            return f"{lhs} = call <64 x float> {target}(<64 x float> {a}, <256 x i1> {mask})"
        if op in VECTOR_SCALAR_INTRINSICS:
            return f"{lhs} = call <64 x float> {target}(<64 x float> {a}, float 2.0, <256 x i1> {mask})"
        if op in VECTOR_DUP_INTRINSICS:
            return f"{lhs} = call <64 x float> {target}(float 3.5, <256 x i1> {mask}, i32 0)"
        raise RuntimeError(f"{case_name}: unsupported op {op}")

    patched, count = call_pattern.subn(replace_call, ir_text)
    if count != 1:
        raise RuntimeError(f"{case_name}: expected one vector compute call to patch, found {count}")

    declare_source = (
        f"declare <64 x float> {source}(<64 x float>, <64 x float>, <256 x i1>)"
    )
    if op in VECTOR_BINARY_INTRINSICS or op in VECTOR_SELECT_INTRINSICS:
        declare_target = f"declare <64 x float> {target}(<64 x float>, <64 x float>, <256 x i1>)"
    elif op in VECTOR_DIFF_EXP_INTRINSICS:
        declare_target = f"declare <64 x float> {target}(<64 x float>, <64 x float>, <256 x i1>, i32)"
    elif op in VECTOR_REDUCTION_INTRINSICS:
        declare_target = f"declare <64 x float> {target}(<64 x float>, <256 x i1>)"
    elif op == "vrec" and decompose_vrec:
        declare_target = "\n".join(
            [
                "declare <64 x float> @llvm.hivm.vbr.f32.v300(float)",
                "declare <64 x float> @llvm.hivm.vdiv.s.x.v64f32(<64 x float>, <64 x float>, <256 x i1>)",
            ]
        )
    elif op == "vmull":
        declare_target = f"declare {{ <64 x float>, <64 x float> }} {target}(<128 x float>, <128 x float>, <256 x i1>, <64 x float>)"
    elif op in VECTOR_UNARY_INTRINSICS:
        declare_target = f"declare <64 x float> {target}(<64 x float>, <256 x i1>)"
    elif op in VECTOR_SCALAR_INTRINSICS:
        declare_target = f"declare <64 x float> {target}(<64 x float>, float, <256 x i1>)"
    elif op in VECTOR_DUP_INTRINSICS:
        declare_target = f"declare <64 x float> {target}(float, <256 x i1>, i32)"
    else:
        raise RuntimeError(f"{case_name}: unsupported op {op}")

    if declare_source not in patched:
        raise RuntimeError(f"{case_name}: source declaration not found")
    return patched.replace(declare_source, declare_target, 1)


def patch_vector_compute_probe_ir(case_cfg: dict[str, Any], ir_text: str) -> str:
    intrinsic = case_cfg["probe_intrinsic"]
    return_type = case_cfg["probe_return_type"]
    source = VECTOR_BINARY_INTRINSICS["vadd"]
    call_pattern = re.compile(
        rf"(?P<lhs>%[-A-Za-z0-9_.$]+)\s*=\s*call\s+<64 x float>\s+{re.escape(source)}"
        r"\(<64 x float>\s+%[-A-Za-z0-9_.$]+,\s+<64 x float>\s+%[-A-Za-z0-9_.$]+,\s+<256 x i1>\s+(?P<mask>%[-A-Za-z0-9_.$]+)\)"
    )

    def replace_call(match: re.Match[str]) -> str:
        lhs = match.group("lhs")
        mask = match.group("mask")
        return (
            f"{lhs} = call {return_type} {intrinsic}"
            f"({return_type} undef, <256 x i1> {mask})"
        )

    patched, count = call_pattern.subn(replace_call, ir_text)
    if count != 1:
        raise RuntimeError(f"{case_cfg['name']}: expected one vector compute call to probe, found {count}")

    declare_source = (
        f"declare <64 x float> {source}(<64 x float>, <64 x float>, <256 x i1>)"
    )
    declare_target = f"declare {return_type} {intrinsic}({return_type}, <256 x i1>)"
    if declare_source not in patched:
        raise RuntimeError(f"{case_cfg['name']}: source declaration not found")
    return patched.replace(declare_source, declare_target, 1)


def patch_mask_patterns(ir_text: str, case_cfg: dict[str, Any]) -> str:
    if "mask_pattern" in case_cfg:
        new_pattern = int(case_cfg["mask_pattern"])
        patched, count = re.subn(
            r"(call\s+<256 x i1>\s+@llvm\.hivm\.pset\.b32\(i32\s+)0(\))",
            rf"\g<1>{new_pattern}\2",
            ir_text,
            count=1,
        )
        if count != 1:
            raise RuntimeError(f"{case_cfg['name']}: expected one pset mask to patch")
        ir_text = patched

    if "store_mask_pattern" in case_cfg:
        store_pattern = int(case_cfg["store_mask_pattern"])
        pset = re.search(
            r"(?P<lhs>%[-A-Za-z0-9_.$]+)\s*=\s*call\s+<256 x i1>\s+@llvm\.hivm\.pset\.b32\(i32\s+\d+\)",
            ir_text,
        )
        if not pset:
            raise RuntimeError(f"{case_cfg['name']}: pset call not found for store mask patch")
        compute_mask = pset.group("lhs")
        store_mask = "%asc_storemask"
        insert = pset.group(0) + f"\n  {store_mask} = call <256 x i1> @llvm.hivm.pset.b32(i32 {store_pattern})"
        ir_text = ir_text.replace(pset.group(0), insert, 1)
        vsts_pattern = re.compile(
            rf"(@llvm\.hivm\.vstsx1\.v64f32\(.+?<256 x i1>\s+){re.escape(compute_mask)}(\))"
        )
        patched, count = vsts_pattern.subn(rf"\g<1>{store_mask}\2", ir_text, count=1)
        if count != 1:
            raise RuntimeError(f"{case_cfg['name']}: expected one vstsx1 store mask to patch")
        ir_text = patched

    return ir_text


def apply_generated_asc_case(case_json: dict[str, Any], generated: str) -> None:
    if generated == "a5_pstu_stream_256":
        seed = [0xA5] * 256

        def pack_prefix(active_lanes: int, lanes: int) -> list[int]:
            packed: list[int] = []
            for byte_base in range(0, lanes, 8):
                value = 0
                for bit in range(8):
                    if byte_base + bit < active_lanes:
                        value |= 1 << bit
                packed.append(value)
            return packed

        golden = list(seed)
        golden[0:16] = pack_prefix(1, 128)
        golden[16:32] = pack_prefix(127, 128)
        golden[32:40] = pack_prefix(13, 64)
        golden[40:48] = pack_prefix(7, 64)
        case_json.clear()
        case_json.update(
            {
                "entry": "dav_pstu_stream",
                "arguments": {"%seed": "seed", "%output": "output"},
                "buffers": {
                    "seed": {"space": "gm", "dtype": "u8", "values": seed},
                    "output": {"space": "gm", "dtype": "u8", "size": 256},
                },
                "ub_dtype": "u8",
                "ub_size_bytes": 256,
                "dma_bytes": 256,
                "checks": [{"buffer": "output", "golden": golden, "atol": 0, "rtol": 0}],
            }
        )
        return
    if generated == "a5_predicate_immediate_32":
        seed = [0] * 32
        golden = [0] * 32
        golden[:2] = [0xFF, 0xFF]
        case_json.clear()
        case_json.update(
            {
                "entry": "dav_predicate_immediate",
                "arguments": {"%seed": "seed", "%output": "output"},
                "buffers": {
                    "seed": {"space": "gm", "dtype": "u8", "values": seed},
                    "output": {"space": "gm", "dtype": "u8", "size": 32},
                },
                "ub_dtype": "u8",
                "ub_size_bytes": 64,
                "dma_bytes": 32,
                "checks": [{"buffer": "output", "golden": golden, "atol": 0, "rtol": 0}],
            }
        )
        return
    if generated == "a5_predicate_widths_256":
        seed = [0xA5] * 256
        for idx in range(32):
            seed[idx] = (idx * 37 + 11) % 256
            seed[32 + idx] = (idx * 53 + 7) % 256
            seed[64 + idx] = (idx * 71 + 3) % 256
        golden = list(seed)
        for source, destination in ((0, 128), (32, 160), (64, 192)):
            golden[destination : destination + 32] = golden[source : source + 32]
        case_json.clear()
        case_json.update(
            {
                "entry": "dav_predicate_widths",
                "arguments": {"%seed": "seed", "%output": "output"},
                "buffers": {
                    "seed": {"space": "gm", "dtype": "u8", "values": seed},
                    "output": {"space": "gm", "dtype": "u8", "size": 256},
                },
                "ub_dtype": "u8",
                "ub_size_bytes": 256,
                "dma_bytes": 256,
                "checks": [{"buffer": "output", "golden": golden, "atol": 0, "rtol": 0}],
            }
        )
        return
    if generated == "a5_vmulscvt_f16_64":
        values = [f32(((idx % 23) - 11) * 0.5) for idx in range(64)]
        for idx, value in ((0, -0.0), (1, 0.0), (2, 65504.0), (31, -65504.0), (32, 1.0), (63, -1.0)):
            values[idx] = f32(value)
        golden = [0.0] * 128
        for idx, value in enumerate(values):
            golden[idx * 2] = f16(f32(value * 0.5))
        case_json.clear()
        case_json.update(
            {
                "entry": "dav_vmulscvt_f16",
                "arguments": {"%input": "input", "%output": "output"},
                "buffers": {
                    "input": {"space": "gm", "dtype": "f32", "values": values},
                    "output": {"space": "gm", "dtype": "f16", "size": 128},
                },
                "ub_dtype": "mixed",
                "ub_size_bytes": 768,
                "dma_bytes": 256,
                "checks": [{"buffer": "output", "golden": golden, "atol": 0, "rtol": 0}],
            }
        )
        return
    if generated == "a5_fused_f32_64":
        lane = range(64)
        x = [f32(((i % 17) - 8) * 0.5) for i in lane]
        for idx, value in ((0, -0.0), (1, 0.0), (31, -7.5), (32, 3.25), (63, -1.0)):
            x[idx] = f32(value)
        acc = [f32(((i * 3) % 19) - 9) for i in lane]
        mul = [f32(((i % 11) - 5) * 0.25) for i in lane]
        golden = []
        for xv, accv, mulv in zip(x, acc, mul):
            relu = f32(xv if xv >= 0.0 else f32(xv * 0.125))
            madd = f32(f32(accv * relu) + mulv)
            golden.append(f32(madd + f32(xv * -0.5)))
        case_json.clear()
        case_json.update(
            {
                "entry": "dav_fused_f32",
                "arguments": {"%x": "x", "%acc": "acc", "%mul": "mul", "%out": "out"},
                "buffers": {
                    "x": {"space": "gm", "dtype": "f32", "values": x},
                    "acc": {"space": "gm", "dtype": "f32", "values": acc},
                    "mul": {"space": "gm", "dtype": "f32", "values": mul},
                    "out": {"space": "gm", "dtype": "f32", "size": 64},
                },
                "ub_size_bytes": 1024,
                "dma_bytes": 256,
                "checks": [{"buffer": "out", "golden": golden, "atol": 0, "rtol": 0}],
            }
        )
        return
    if generated == "a5_fused_f16_128":
        lane = range(128)
        x = [f16(((i % 17) - 8) * 0.5) for i in lane]
        for idx, value in ((0, -0.0), (1, 0.0), (63, -7.5), (64, 3.25), (127, -1.0)):
            x[idx] = f16(value)
        acc = [f16(((i * 3) % 19) - 9) for i in lane]
        mul = [f16(((i % 11) - 5) * 0.25) for i in lane]
        golden = []
        for xv, accv, mulv in zip(x, acc, mul):
            relu = f16(xv if xv >= 0.0 else f16(xv * 0.125))
            madd = f16(f16(accv * relu) + mulv)
            golden.append(f16(madd + f16(xv * -0.5)))
        case_json.clear()
        case_json.update(
            {
                "entry": "dav_fused_f16",
                "arguments": {"%x": "x", "%acc": "acc", "%mul": "mul", "%out": "out"},
                "buffers": {
                    "x": {"space": "gm", "dtype": "f16", "values": x},
                    "acc": {"space": "gm", "dtype": "f16", "values": acc},
                    "mul": {"space": "gm", "dtype": "f16", "values": mul},
                    "out": {"space": "gm", "dtype": "f16", "size": 128},
                },
                "ub_dtype": "f16",
                "ub_size_bytes": 2048,
                "dma_bytes": 256,
                "checks": [{"buffer": "out", "golden": golden, "atol": 0, "rtol": 0}],
            }
        )
        return
    if generated == "f16_vadd_128":
        a = [f16((idx - 64) / 4.0) for idx in range(128)]
        b = [f16((idx % 17) / 8.0 - 1.0) for idx in range(128)]
        golden = [f16(x + y) for x, y in zip(a, b)]
        case_json.clear()
        case_json.update(
            {
                "entry": "add_kernel",
                "arguments": {"%0": "x", "%1": "y", "%2": "output"},
                "scalars": {"%3": 128},
                "buffers": {
                    "x": {"space": "gm", "dtype": "f16", "values": a},
                    "y": {"space": "gm", "dtype": "f16", "values": b},
                    "output": {"space": "gm", "dtype": "f16", "size": 128},
                },
                "ub_dtype": "f16",
                "ub_size_bytes": 768,
                "dma_bytes": 256,
                "checks": [{"buffer": "output", "golden": golden, "atol": 0, "rtol": 0}],
            }
        )
        return
    if generated == "f16_roundtrip_128":
        values = [f16((idx - 64) / 4.0) for idx in range(128)]
        case_json.clear()
        case_json.update(
            {
                "entry": "dav_f16_roundtrip",
                "arguments": {"%a": "a", "%out": "out"},
                "buffers": {
                    "a": {"space": "gm", "dtype": "f16", "values": values},
                    "out": {"space": "gm", "dtype": "f16", "size": 128},
                },
                "ub_dtype": "f16",
                "ub_size_bytes": 512,
                "dma_bytes": 256,
                "checks": [{"buffer": "out", "golden": values, "atol": 0, "rtol": 0}],
            }
        )
        return
    if generated == "special_f32_64":
        base_a = [
            0.0,
            -0.0,
            1.0,
            -1.0,
            float("inf"),
            float("-inf"),
            float("nan"),
            1.401298464324817e-45,
            1.1754943508222875e-38,
            3.4028234663852886e38,
        ]
        base_b = [
            -0.0,
            0.0,
            -1.0,
            1.0,
            1.0,
            -1.0,
            2.0,
            -1.401298464324817e-45,
            1.1754943508222875e-38,
            -3.4028234663852886e38,
        ]
        a = [f32(base_a[i % len(base_a)]) for i in range(64)]
        b = [f32(base_b[i % len(base_b)]) for i in range(64)]
    elif generated == "float32_overflow_64":
        a = [f32(3.4028234663852886e38)] * 64
        b = [f32(3.4028234663852886e38)] * 64
    else:
        raise RuntimeError(f"unknown generated ASC case: {generated}")

    golden = [eval_vector_op("vadd", float(x), float(y), 0.0) for x, y in zip(a, b)]
    case_json["buffers"]["a"]["values"] = a
    case_json["buffers"]["b"]["values"] = b
    case_json["checks"][0]["golden"] = golden


def lower_opentile_case(
    opentileas_repo: Path,
    build_dir: Path,
    mlir: Path,
    target: str,
    fusion_mode: str,
    tmp_dir: Path,
) -> tuple[Path, subprocess.CompletedProcess[str]]:
    script = opentileas_repo / "simulator" / "scripts" / "ascend_simu.py"
    output_dir = tmp_dir / "lowered"
    output_dir.mkdir(parents=True, exist_ok=True)
    cmd = [
        sys.executable,
        str(script),
        "lower",
        "--repo",
        str(opentileas_repo),
        "--build-dir",
        str(build_dir),
        "--mlir",
        str(mlir),
        "--output-dir",
        str(output_dir),
        "--target",
        target,
        "--fusion-mode",
        fusion_mode,
    ]
    result = run_command(cmd)
    candidates = sorted(output_dir.glob("*.ll"))
    if not candidates:
        raise RuntimeError("OpenTileAS lowering did not produce an LLVM IR .ll file")
    return candidates[0], result


def materialize_lowered_ir(
    case_cfg: dict[str, Any],
    opentileas_repo: Path,
    build_dir: Path,
    tmp_dir: Path,
) -> tuple[Path, subprocess.CompletedProcess[str]]:
    mlir = (opentileas_repo / case_cfg["mlir"]).resolve()
    lowered, lower_result = lower_opentile_case(
        opentileas_repo,
        build_dir,
        mlir,
        case_cfg.get("target", "dav-351x"),
        case_cfg.get("fusion_mode", "no_fuse"),
        tmp_dir,
    )
    op = case_cfg.get("op", "vadd")
    text = lowered.read_text(encoding="utf-8")
    mode = case_cfg.get("mode", "x")
    if "probe_intrinsic" in case_cfg:
        text = patch_vector_compute_probe_ir(case_cfg, text)
    elif op != "vadd" or mode != "x":
        text = patch_vector_compute_ir(
            case_cfg["name"],
            text,
            op,
            lowered=True,
            mode=mode,
            part=int(case_cfg.get("part", 0)),
            extract=int(case_cfg.get("extract", 0)),
            decompose_vrec=bool(case_cfg.get("decompose_vrec", False)),
        )
    text = patch_mask_patterns(text, case_cfg)
    if op == "vadd" and mode == "x" and not any(k in case_cfg for k in ("mask_pattern", "store_mask_pattern")):
        return lowered, lower_result
    patched = lowered.with_name(f"{safe_slug(op + '-' + mode)}-{lowered.name}")
    patched.write_text(text, encoding="utf-8")
    return patched, lower_result


def extract_hivm_intrinsics(text: str) -> set[str]:
    return set(HIVM_INTRINSIC_RE.findall(text))


def run_external_asc_static_case(
    case_cfg: dict[str, Any],
    opentileas_repo: Path,
    build_dir: Path,
    tmp_dir: Path,
) -> dict[str, Any]:
    expected = case_cfg.get("expect_asc_status", "pass")
    try:
        lowered, lower_result = lower_opentile_case(
            opentileas_repo,
            build_dir,
            (opentileas_repo / case_cfg["mlir"]).resolve(),
            case_cfg.get("target", "dav-351x"),
            case_cfg.get("fusion_mode", "no_fuse"),
            tmp_dir / case_cfg["name"],
        )
        text = lowered.read_text(encoding="utf-8", errors="ignore")
        found = extract_hivm_intrinsics(text)
        configured = {
            name if name.startswith("@") else "@" + name
            for name in case_cfg.get("intrinsics", [])
        }
        missing_configured = sorted(configured - found)
        unconfigured_found = sorted(found - configured)
        unsupported = sorted(found - ASC_MODEL_SUPPORTED_INTRINSICS)
        if lower_result.returncode != 0:
            status = "lower_error"
        elif missing_configured or unconfigured_found:
            status = "coverage_config_error"
        elif unsupported:
            status = "static_unsupported"
        else:
            status = "pass"
        details = []
        if unsupported:
            details.append("unsupported intrinsics: " + ", ".join(unsupported[:12]))
            if len(unsupported) > 12:
                details.append(f"... {len(unsupported) - 12} more unsupported intrinsics")
        if missing_configured:
            details.append("configured intrinsics missing from lowered IR: " + ", ".join(missing_configured))
        if unconfigured_found:
            details.append("lowered IR intrinsics missing from suite config: " + ", ".join(unconfigured_found))
        if lower_result.returncode != 0:
            details.append(tail(lower_result.stderr))
        return {
            "name": case_cfg["name"],
            "kind": "external-asc-static",
            "oracle_key": oracle_key(case_cfg),
            "status": status,
            "expected": expected,
            "ok": status == expected,
            "returncode": lower_result.returncode,
            "lowered_ir": str(lowered),
            "intrinsics": sorted(found),
            "unsupported_intrinsics": unsupported,
            "stderr_tail": "\n".join(part for part in details if part),
            "stdout_tail": tail(lower_result.stdout),
        }
    except Exception as exc:
        status = "lower_error"
        return {
            "name": case_cfg["name"],
            "kind": "external-asc-static",
            "oracle_key": oracle_key(case_cfg),
            "status": status,
            "expected": expected,
            "ok": status == expected,
            "returncode": None,
            "lowered_ir": None,
            "intrinsics": [],
            "unsupported_intrinsics": [],
            "stderr_tail": f"external-case-error: {exc}",
            "stdout_tail": "",
        }


def run_lowered_case(
    case_cfg: dict[str, Any],
    asc_sim: Path,
    opentileas_repo: Path,
    build_dir: Path,
    tmp_dir: Path,
) -> dict[str, Any]:
    expected = case_cfg.get("expect_asc_status", "pass")
    try:
        lowered, lower_result = materialize_lowered_ir(
            case_cfg,
            opentileas_repo,
            build_dir,
            tmp_dir / case_cfg["name"],
        )
    except Exception as exc:
        return {
            "name": case_cfg["name"],
            "kind": "lowered-opentile",
            "oracle_key": oracle_key(case_cfg),
            "status": "oracle_materialization_error",
            "expected": expected,
            "ok": expected == "oracle_materialization_error",
            "returncode": None,
            "lower_returncode": None,
            "lowered_ir": None,
            "stderr_tail": f"materialize-error: {exc}",
            "stdout_tail": "",
        }
    local_case = generated_vector_case(
        case_cfg.get("op", "vadd"),
        case_cfg.get("mode", "x"),
        int(case_cfg.get("n_elements", case_cfg.get("elements", 1024))),
        int(case_cfg.get("allocated_elements", 1024)),
        int(case_cfg.get("ub_size_bytes", 12288)),
        int(case_cfg.get("dma_bytes", 4096)),
        int(case_cfg.get("mask_pattern", 0)),
        int(case_cfg.get("extract", 0)),
    )
    work_case = tmp_dir / f"{case_cfg['name']}.case.json"
    write_json(work_case, local_case)
    result = run_command([str(asc_sim), str(lowered), "--case", str(work_case)])
    status = classify_asc_status(result.returncode)
    return {
        "name": case_cfg["name"],
        "kind": "lowered-opentile",
        "oracle_key": oracle_key(case_cfg),
        "status": status,
        "expected": expected,
        "ok": status == expected and lower_result.returncode == 0,
        "returncode": result.returncode,
        "lower_returncode": lower_result.returncode,
        "lowered_ir": str(lowered),
        "stderr_tail": tail(result.stderr),
        "stdout_tail": tail(result.stdout),
    }


def simulator_case_needs_lowered_ir(case_cfg: dict[str, Any]) -> bool:
    if case_cfg.get("external_case"):
        return False
    return (
        case_cfg.get("op", "vadd") != "vadd"
        or case_cfg.get("mode", "x") != "x"
        or "mask_pattern" in case_cfg
        or "store_mask_pattern" in case_cfg
    )


def verify_materialized_ir(case_cfg: dict[str, Any], source_path: Path) -> None:
    text = source_path.read_text(encoding="utf-8", errors="ignore")
    if "probe_intrinsic" in case_cfg:
        expected = case_cfg["probe_intrinsic"]
        if expected not in text:
            raise RuntimeError(f"{case_cfg['name']}: materialized IR missing {expected}")
        return
    if "intrinsics" in case_cfg and ("ir" in case_cfg or case_cfg.get("op") is None):
        for expected in (
            name if name.startswith("@") else "@" + name
            for name in case_cfg["intrinsics"]
        ):
            if expected not in text:
                raise RuntimeError(f"{case_cfg['name']}: materialized IR missing {expected}")
        return
    op = case_cfg.get("op", "vadd")
    mode = case_cfg.get("mode", "x")
    expected_intrinsic = op_intrinsic(op, mode)
    if op == "vrec" and case_cfg.get("decompose_vrec"):
        for expected in (
            "@llvm.hivm.vbr.f32.v300",
            "@llvm.hivm.vdiv.s.x.v64f32",
        ):
            if expected not in text:
                raise RuntimeError(f"{case_cfg['name']}: materialized IR missing {expected}")
        return
    if expected_intrinsic not in text:
        raise RuntimeError(
            f"{case_cfg['name']}: materialized IR does not contain {expected_intrinsic}"
        )
    if "mask_pattern" in case_cfg:
        expected = f"@llvm.hivm.pset.b32(i32 {int(case_cfg['mask_pattern'])})"
        if expected not in text:
            raise RuntimeError(f"{case_cfg['name']}: materialized IR missing compute {expected}")
    if "store_mask_pattern" in case_cfg:
        expected = f"@llvm.hivm.pset.b32(i32 {int(case_cfg['store_mask_pattern'])})"
        if expected not in text:
            raise RuntimeError(f"{case_cfg['name']}: materialized IR missing store {expected}")
    if op == "vexpdif":
        expected = f", i32 {int(case_cfg.get('part', 0))})"
        if expected not in text:
            raise RuntimeError(f"{case_cfg['name']}: materialized IR missing vexpdif {expected}")


def run_simulator_case(
    case_cfg: dict[str, Any],
    suite_dir: Path,
    opentileas_repo: Path,
    build_dir: Path,
    ssh: str,
    developer: str,
    launcher: str,
    tmp_dir: Path,
) -> dict[str, Any]:
    script = opentileas_repo / "simulator" / "scripts" / "ascend_simu.py"
    run_id = safe_slug(f"asc-oracle-{case_cfg['name']}-{int(time.time())}")
    expected = case_cfg.get("expect_simulator_status", "pass")
    try:
        case_dir = materialize_simulator_case(case_cfg, opentileas_repo, tmp_dir)
        if "ir" in case_cfg:
            source_flag = "--llvm-ir"
            source_path = (suite_dir / case_cfg["ir"]).resolve()
            verify_materialized_ir(case_cfg, source_path)
        else:
            source_flag = "--mlir"
            source_path = opentileas_repo / case_cfg["mlir"]
        if "ir" not in case_cfg and simulator_case_needs_lowered_ir(case_cfg):
            source_path, _ = materialize_lowered_ir(
                case_cfg,
                opentileas_repo,
                build_dir,
                tmp_dir / f"sim-ir-{case_cfg['name']}",
            )
            source_flag = "--llvm-ir"
            verify_materialized_ir(case_cfg, source_path)
    except Exception as exc:
        return {
            "name": case_cfg["name"],
            "kind": "simulator-oracle",
            "oracle_key": oracle_key(case_cfg),
            "status": "oracle_materialization_error",
            "expected": expected,
            "ok": expected == "oracle_materialization_error",
            "returncode": None,
            "local_run": None,
            "stderr_tail": f"materialize-error: {exc}",
            "stdout_tail": "",
        }
    cmd = [
        sys.executable,
        str(script),
        "run",
        "--repo",
        str(opentileas_repo),
        "--build-dir",
        str(build_dir),
        "--ssh",
        ssh,
        "--launcher",
        launcher,
        "--developer",
        developer,
        "--run-id",
        run_id,
        source_flag,
        str(source_path),
        "--case-dir",
        str(case_dir),
        "--config",
        case_cfg.get("config", "runner.json"),
        "--core",
        case_cfg.get("core", "vec"),
        "--target",
        case_cfg.get("target", "dav-351x"),
    ]
    result = run_command(cmd)
    status, compare_tail = classify_simulator_status(result)
    return {
        "name": case_cfg["name"],
        "kind": "simulator-oracle",
        "oracle_key": oracle_key(case_cfg),
        "status": status,
        "expected": expected,
        "ok": status == expected,
        "returncode": result.returncode,
        "local_run": parse_local_run(result.stdout),
        "stderr_tail": compare_tail or tail(result.stderr),
        "stdout_tail": tail(result.stdout),
    }


def materialize_simulator_case(case_cfg: dict[str, Any], opentileas_repo: Path, tmp_dir: Path) -> Path:
    source = opentileas_repo / case_cfg["case_dir"]
    if case_cfg.get("external_case"):
        return source
    if "n_elements" not in case_cfg and case_cfg.get("op", "vadd") == "vadd":
        return source

    target = tmp_dir / f"simulator-{safe_slug(case_cfg['name'])}"
    shutil.copytree(source, target)
    runner_path = target / case_cfg.get("config", "runner.json")
    runner = load_json(runner_path)
    simulator_dtype = case_cfg.get("simulator_dtype")
    simulator_shape = int(case_cfg.get("simulator_shape", case_cfg.get("n_elements", 1024)))
    for arg in runner.get("args", []):
        if arg.get("name") == "n_elements":
            arg["value"] = int(case_cfg["n_elements"])
        if simulator_dtype and arg.get("kind") in ("input", "output") and arg.get("dtype") in (
            "float32",
            "float16",
        ):
            arg["dtype"] = simulator_dtype
            arg["shape"] = [simulator_shape]
            if arg.get("kind") == "output":
                arg["path"] = arg.get("path", "output.npy")
    if case_cfg.get("op") == "vexpdif":
        golden_spec = runner.setdefault("golden", {})
        golden_spec["atol"] = float(case_cfg.get("golden_atol", 1e-5))
        golden_spec["rtol"] = float(case_cfg.get("golden_rtol", 1e-5))
    write_json(runner_path, runner)
    (target / "golden.py").write_text(
        "\n".join(
            [
                "import numpy as np",
                "",
                "",
                f"OP = {case_cfg.get('op', 'vadd')!r}",
                f"MODE = {case_cfg.get('mode', 'x')!r}",
                f"PART = {int(case_cfg.get('part', 0))!r}",
                f"EXTRACT = {int(case_cfg.get('extract', 0))!r}",
                f"MASK_PATTERN = {int(case_cfg.get('mask_pattern', 0))!r}",
                f"STORE_MASK_PATTERN = {int(case_cfg.get('store_mask_pattern', case_cfg.get('mask_pattern', 0)))!r}",
                f"VECTOR_LANES = {int(case_cfg.get('vector_lanes', 64))!r}",
                f"OUTPUT_DTYPE = np.dtype({case_cfg.get('simulator_dtype', 'float32')!r})",
                "SCALAR = 2.0 if OP != 'vdups' else 3.5",
                "",
                "",
                "def _active_lanes(pattern: int) -> int:",
                "    return {0: VECTOR_LANES, 5: 4, 6: 8, 7: 16, 8: 32, 9: 64}[int(pattern)]",
                "",
                "",
                "def _apply(x: np.ndarray, y: np.ndarray) -> np.ndarray:",
                "    if OP == 'vadd':",
                "        return x + y",
                "    if OP == 'vsub':",
                "        return x - y",
                "    if OP == 'vmul':",
                "        return x * y",
                "    if OP == 'vdiv':",
                "        return x / y",
                "    if OP == 'vmax':",
                "        return np.maximum(x, y)",
                "    if OP == 'vmin':",
                "        return np.minimum(x, y)",
                "    if OP == 'vsel':",
                "        return x",
                "    if OP == 'vabs':",
                "        return np.abs(x)",
                "    if OP == 'vneg':",
                "        return -x",
                "    if OP == 'vrelu':",
                "        return np.maximum(x, np.float32(0.0))",
                "    if OP == 'vsqrt':",
                "        return np.sqrt(x)",
                "    if OP == 'vrsqrt':",
                "        return np.float32(1.0) / np.sqrt(x)",
                "    if OP == 'vrec':",
                "        return np.float32(1.0) / x",
                "    if OP == 'vexp':",
                "        return np.exp(x)",
                "    if OP == 'vln':",
                "        return np.log(x)",
                "    if OP == 'vexpdif':",
                "        if PART != 0:",
                "            raise ValueError(f'unsupported vexpdif part: {PART}')",
                "        return np.exp(x - y)",
                "    if OP == 'vcadd':",
                "        return x",
                "    if OP == 'vcmax':",
                "        return x",
                "    if OP == 'vcmin':",
                "        return x",
                "    if OP == 'vmull':",
                "        src = x if EXTRACT == 0 else y",
                "        return src * src",
                "    if OP == 'vadds':",
                "        return x + np.float32(SCALAR)",
                "    if OP == 'vmuls':",
                "        return x * np.float32(SCALAR)",
                "    if OP == 'vmaxs':",
                "        return np.maximum(x, np.float32(SCALAR))",
                "    if OP == 'vmins':",
                "        return np.minimum(x, np.float32(SCALAR))",
                "    if OP == 'vdups':",
                "        return np.full_like(x, np.float32(SCALAR), dtype=np.float32)",
                "    raise ValueError(f'unsupported op: {OP}')",
                "",
                "",
                "def add(x: np.ndarray, y: np.ndarray, n_elements: int) -> np.ndarray:",
                "    n = max(0, min(int(n_elements), x.shape[0]))",
                "    out = np.zeros_like(x, dtype=OUTPUT_DTYPE)",
                "    computed = _apply(x[:n], y[:n]).astype(OUTPUT_DTYPE)",
                "    compute_active = _active_lanes(MASK_PATTERN)",
                "    store_active = _active_lanes(STORE_MASK_PATTERN)",
                "    for idx in range(n):",
                "        lane = idx % VECTOR_LANES",
                "        if lane >= store_active:",
                "            continue",
                "        if OP == 'vsel':",
                "            out[idx] = x[idx] if lane < compute_active else y[idx]",
                "            continue",
                "        if OP in ('vcadd', 'vcmax', 'vcmin'):",
                "            if lane == 0:",
                "                end = min(idx + 64, n)",
                "                active_end = min(idx + compute_active, end)",
                "                values = x[idx:active_end].astype(np.float32)",
                "                if OP == 'vcadd':",
                "                    out[idx] = np.sum(values, dtype=np.float32)",
                "                elif OP == 'vcmax':",
                "                    out[idx] = np.max(values).astype(np.float32)",
                "                else:",
                "                    out[idx] = np.min(values).astype(np.float32)",
                "            continue",
                "        if lane < compute_active:",
                "            out[idx] = computed[idx]",
                "        elif MODE == 'm':",
                "            out[idx] = x[idx]",
                "        else:",
                "            out[idx] = np.float32(0.0)",
                "    return out.astype(OUTPUT_DTYPE)",
                "",
            ]
        ),
        encoding="utf-8",
    )
    return target


def safe_slug(text: str) -> str:
    text = re.sub(r"[^A-Za-z0-9_.-]+", "-", text.strip())
    return text.strip("-") or "run"


def parse_local_run(output: str) -> str | None:
    for line in output.splitlines():
        if line.startswith("local run: "):
            return line.split(": ", 1)[1]
    return None


def tail(text: str, lines: int = 12) -> str:
    parts = [line for line in text.splitlines() if line.strip()]
    return "\n".join(parts[-lines:])


def print_report(results: list[dict[str, Any]]) -> None:
    for item in results:
        marker = "OK" if item["ok"] else "FAIL"
        print(f"[{marker}] {item['name']} ({item['kind']}): {item['status']} expected {item['expected']}")
        if item.get("local_run"):
            print(f"  local_run: {item['local_run']}")
        if not item["ok"] and item.get("stderr_tail"):
            print("  stderr:")
            for line in item["stderr_tail"].splitlines():
                print(f"    {line}")
    failures = [item for item in results if not item["ok"]]
    print(f"summary: {len(results) - len(failures)}/{len(results)} checks passed")


def oracle_key(case_cfg: dict[str, Any]) -> str:
    if case_cfg.get("kernel_id"):
        return str(case_cfg["kernel_id"])
    fields = [
        ("source", case_cfg.get("mlir") or case_cfg.get("ir")),
        ("op", case_cfg.get("op", "vadd")),
        ("mode", case_cfg.get("mode", "x")),
        ("part", case_cfg.get("part") if case_cfg.get("op") == "vexpdif" else None),
        ("extract", case_cfg.get("extract") if case_cfg.get("op") == "vmull" else None),
        ("decompose_vrec", case_cfg.get("decompose_vrec") if case_cfg.get("op") == "vrec" else None),
        ("mask", case_cfg.get("mask_pattern", 0)),
        ("store_mask", case_cfg.get("store_mask_pattern", case_cfg.get("mask_pattern", 0))),
        ("n", case_cfg.get("n_elements")),
        ("alloc", case_cfg.get("allocated_elements", 1024)),
        ("ub", case_cfg.get("ub_size_bytes", 12288)),
        ("dma", case_cfg.get("dma_bytes", 4096)),
        ("target", case_cfg.get("target", "dav-351x")),
        ("core", case_cfg.get("core", "vec")),
        ("fusion", case_cfg.get("fusion_mode", "no_fuse")),
    ]
    return "|".join(f"{name}={value}" for name, value in fields if value not in (None, ""))


def check_simulator_coverage(suite: dict[str, Any], run_simulator: bool) -> list[str]:
    simulator_keys = {oracle_key(case) for case in suite.get("simulator_cases", [])}
    gaps: list[str] = []
    for case in suite.get("lowered_cases", []):
        if case.get("expect_asc_status", "pass") != "pass":
            continue
        if not case.get("require_simulator", True):
            continue
        key = oracle_key(case)
        if key not in simulator_keys:
            gaps.append(
                f"{case['name']}: ASC pass case has no simulator oracle "
                f"for kernel key {key!r}"
            )
    for case in suite.get("external_cases", []):
        if case.get("expect_asc_status", "pass") != "pass":
            continue
        if not case.get("require_simulator", True):
            continue
        if "expect_simulator_status" not in case:
            gaps.append(
                f"{case['name']}: external ASC pass case has no simulator oracle status"
            )
        elif not run_simulator:
            gaps.append(
                f"{case['name']}: external ASC pass case requires --run-simulator"
            )
    if gaps and not run_simulator:
        gaps.append("run with --run-simulator to execute configured simulator oracle cases")
    return gaps


def check_behavior_consistency(results: list[dict[str, Any]], run_simulator: bool) -> list[str]:
    if not run_simulator:
        return ["behavior consistency requires --run-simulator"]

    by_key: dict[str, dict[str, list[dict[str, Any]]]] = {}
    for item in results:
        key = item.get("oracle_key")
        if not key:
            continue
        bucket = by_key.setdefault(str(key), {"asc": [], "simulator": []})
        if item.get("kind") == "simulator-oracle":
            bucket["simulator"].append(item)
        elif item.get("kind") in ("asc-ir", "lowered-opentile", "external-asc-static"):
            bucket["asc"].append(item)

    gaps: list[str] = []
    for key, grouped in sorted(by_key.items()):
        asc_passes = [item for item in grouped["asc"] if item.get("status") == "pass"]
        if not asc_passes:
            continue
        simulator_results = grouped["simulator"]
        if not simulator_results:
            continue
        simulator_passes = [item for item in simulator_results if item.get("status") == "pass"]
        if simulator_passes:
            continue
        asc_names = ", ".join(item["name"] for item in asc_passes)
        simulator_states = ", ".join(
            f"{item['name']}:{item['status']}" for item in simulator_results
        )
        gaps.append(
            f"{key}: ASC pass result(s) [{asc_names}] have no matching simulator pass; "
            f"simulator result(s): [{simulator_states}]"
        )
    return gaps


def discover_a5_mlir_cases(opentileas_repo: Path) -> dict[str, Path]:
    cases_dir = opentileas_repo / "simulator" / "cases"
    if not cases_dir.is_dir():
        return {}
    discovered: dict[str, Path] = {}
    for mlir_path in sorted(cases_dir.glob("a5_*/kernel.cce.mlir")):
        discovered[f"opentile_{mlir_path.parent.name}"] = mlir_path
    return discovered


def check_a5_external_coverage(suite: dict[str, Any], opentileas_repo: Path) -> list[str]:
    discovered = discover_a5_mlir_cases(opentileas_repo)
    gaps: list[str] = []
    if not discovered:
        gaps.append(f"no OpenTileAS A5 MLIR cases found under {opentileas_repo / 'simulator' / 'cases'}")
        return gaps

    configured_cases = {
        case["name"]: case
        for case in suite.get("external_cases", [])
        if case.get("name", "").startswith("opentile_a5_")
    }
    missing = sorted(set(discovered) - set(configured_cases))
    stale = sorted(set(configured_cases) - set(discovered))
    for name in missing:
        rel = discovered[name].relative_to(opentileas_repo)
        gaps.append(f"{name}: OpenTileAS A5 MLIR case is missing from suite external_cases ({rel})")
    for name in stale:
        gaps.append(f"{name}: suite external_cases entry has no matching OpenTileAS simulator/cases/a5_* directory")

    for name, case in sorted(configured_cases.items()):
        mlir_value = case.get("mlir")
        if not mlir_value:
            gaps.append(f"{name}: suite external_cases entry is missing mlir")
            continue
        mlir_path = (opentileas_repo / mlir_value).resolve()
        expected_path = discovered.get(name)
        if not mlir_path.is_file():
            gaps.append(f"{name}: configured MLIR path does not exist: {mlir_value}")
            continue
        if expected_path and mlir_path != expected_path.resolve():
            expected_rel = expected_path.relative_to(opentileas_repo)
            gaps.append(f"{name}: configured MLIR path {mlir_value} does not match discovered {expected_rel}")
        case_dir_value = case.get("case_dir")
        if case_dir_value and not (opentileas_repo / case_dir_value).is_dir():
            gaps.append(f"{name}: configured case_dir does not exist: {case_dir_value}")
    return gaps


def filter_suite_cases(suite: dict[str, Any], case_filter: str) -> dict[str, Any]:
    pattern = re.compile(case_filter)
    filtered = copy.deepcopy(suite)
    for section in ("asc_cases", "lowered_cases", "simulator_cases", "external_cases"):
        filtered[section] = [
            case for case in filtered.get(section, []) if pattern.search(case["name"])
        ]
    return filtered


def main(argv: list[str]) -> int:
    root = repo_root()
    default_suite = root / "examples" / "davsim" / "vadd" / "oracle" / "vadd_oracle_suite.json"
    default_opentileas = root.parent / "OpenTileAS"
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--suite", type=Path, default=default_suite)
    parser.add_argument("--asc-sim", type=Path, default=root / "build" / "bin" / "asc-sim")
    parser.add_argument("--opentileas-repo", type=Path, default=default_opentileas)
    parser.add_argument("--opentileas-build-dir", type=Path, default=default_opentileas / "build")
    parser.add_argument("--skip-lowered", action="store_true")
    parser.add_argument("--run-simulator", action="store_true")
    parser.add_argument("--ssh", default=os.environ.get("ASCEND_SIM_SSH", "opentile-simu"))
    parser.add_argument("--developer", default=os.environ.get("USER", "developer"))
    parser.add_argument("--launcher", default="/usr/local/sbin/opentileas-simu-exec")
    parser.add_argument("--report", type=Path)
    parser.add_argument(
        "--case-filter",
        help="only run suite cases whose name matches this regular expression",
    )
    parser.add_argument(
        "--enforce-simulator-coverage",
        action="store_true",
        help="fail if an ASC-pass lowered case lacks a matching simulator oracle case",
    )
    parser.add_argument(
        "--enforce-a5-external-coverage",
        action="store_true",
        help="fail if OpenTileAS simulator/cases/a5_* MLIR cases are missing from suite external_cases",
    )
    parser.add_argument(
        "--enforce-behavior-consistency",
        action="store_true",
        help="fail if an actual ASC-pass result has a matching simulator result that is not pass",
    )
    args = parser.parse_args(argv)

    suite_path = args.suite.resolve()
    full_suite = load_json(suite_path)
    suite = full_suite
    if args.case_filter:
        suite = filter_suite_cases(suite, args.case_filter)
    suite_dir = suite_path.parent
    asc_sim = args.asc_sim.resolve()
    if not asc_sim.is_file():
        raise SystemExit(f"asc-sim not found: {asc_sim}")

    results: list[dict[str, Any]] = []
    with tempfile.TemporaryDirectory(prefix="asc-sim-oracle-") as tmp:
        tmp_dir = Path(tmp)
        for case_cfg in suite.get("asc_cases", []):
            results.append(run_asc_ir_case(case_cfg, suite_dir, asc_sim, tmp_dir))
        if not args.skip_lowered:
            for case_cfg in suite.get("lowered_cases", []):
                results.append(
                    run_lowered_case(
                        case_cfg,
                        asc_sim,
                        args.opentileas_repo.resolve(),
                        args.opentileas_build_dir.resolve(),
                        tmp_dir,
                    )
                )
            for case_cfg in suite.get("external_cases", []):
                results.append(
                    run_external_asc_static_case(
                        case_cfg,
                        args.opentileas_repo.resolve(),
                        args.opentileas_build_dir.resolve(),
                        tmp_dir,
                    )
                )
        if args.run_simulator:
            for case_cfg in suite.get("simulator_cases", []):
                results.append(
                    run_simulator_case(
                        case_cfg,
                        suite_dir,
                        args.opentileas_repo.resolve(),
                        args.opentileas_build_dir.resolve(),
                        args.ssh,
                        args.developer,
                        args.launcher,
                        tmp_dir,
                    )
                )
            for case_cfg in suite.get("external_cases", []):
                external_cfg = dict(case_cfg)
                external_cfg["external_case"] = True
                results.append(
                    run_simulator_case(
                        external_cfg,
                        suite_dir,
                        args.opentileas_repo.resolve(),
                        args.opentileas_build_dir.resolve(),
                        args.ssh,
                        args.developer,
                        args.launcher,
                        tmp_dir,
                    )
                )

    print_report(results)
    coverage_gaps = check_simulator_coverage(suite, args.run_simulator)
    behavior_gaps = check_behavior_consistency(results, args.run_simulator)
    a5_coverage_gaps = check_a5_external_coverage(full_suite, args.opentileas_repo.resolve())
    if args.enforce_simulator_coverage and coverage_gaps:
        print("[simulator-coverage]")
        for gap in coverage_gaps:
            print(f"  {gap}")
    if args.enforce_behavior_consistency and behavior_gaps:
        print("[behavior-consistency]")
        for gap in behavior_gaps:
            print(f"  {gap}")
    if args.enforce_a5_external_coverage and a5_coverage_gaps:
        print("[a5-external-coverage]")
        for gap in a5_coverage_gaps:
            print(f"  {gap}")
    if args.report:
        write_json(
            args.report.resolve(),
            {
                "results": results,
                "coverage_gaps": coverage_gaps,
                "behavior_consistency_gaps": behavior_gaps,
                "a5_external_coverage_gaps": a5_coverage_gaps,
            },
        )
    return (
        0
        if all(item["ok"] for item in results)
        and not (args.enforce_simulator_coverage and coverage_gaps)
        and not (args.enforce_behavior_consistency and behavior_gaps)
        and not (args.enforce_a5_external_coverage and a5_coverage_gaps)
        else 1
    )


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
