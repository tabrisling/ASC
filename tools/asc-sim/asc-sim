class SimError(RuntimeError):
    pass


@dataclass
class Buffer:
    name: str
    values: list[int | float]
    dtype: str = "f32"
    space: str = "ub"


@dataclass
class TypedValue:
    value: str | int | float
    addrspace: int | None = None


@dataclass
class PointerValue:
    buffer: str
    addrspace: int
    byte_offset: int = 0


@dataclass
class AggregateValue:
    elements: list[Any]


@dataclass
class PredicateBytes:
    values: list[int]


@dataclass
class AlignData:
    values: list[int]


def strip_comment(line: str) -> str:
    return line.split(";", 1)[0].strip()


def split_args(arg_text: str) -> list[str]:
    args: list[str] = []
    cur: list[str] = []
    depth_angle = 0
    depth_paren = 0
    for ch in arg_text:
        if ch == "<":
            depth_angle += 1
        elif ch == ">":
            depth_angle -= 1
        elif ch == "(":
            depth_paren += 1
        elif ch == ")":
            depth_paren -= 1
        elif ch == "," and depth_angle == 0 and depth_paren == 0:
            args.append("".join(cur).strip())
            cur = []
            continue
        cur.append(ch)
    if cur:
        args.append("".join(cur).strip())
    return args


def parse_typed_value(text: str) -> TypedValue:
    text = text.strip()
    addrspace = None
    m_space = re.search(r"addrspace\((\d+)\)", text)
    if m_space:
        addrspace = int(m_space.group(1))

    if "null" in text and addrspace is not None:
        return TypedValue(0, addrspace)

    if re.search(r"\bundef\b", text):
        return TypedValue("undef", addrspace)

    m_half_hex = re.search(r"half\s+0xH([0-9A-Fa-f]{4})\s*$", text)
    if m_half_hex:
        bits = int(m_half_hex.group(1), 16)
        return TypedValue(struct.unpack("<e", struct.pack("<H", bits))[0], addrspace)

    m_float = re.search(
        r"(?:float|double)\s+([+-]?(?:nan|inf|infinity|(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?))\s*$",
        text,
        re.I,
    )
    if m_float:
        token = m_float.group(1).lower()
        if token == "nan":
            return TypedValue(float("nan"), addrspace)
        if token in ("inf", "+inf", "infinity", "+infinity"):
            return TypedValue(float("inf"), addrspace)
        if token in ("-inf", "-infinity"):
            return TypedValue(float("-inf"), addrspace)
        return TypedValue(float(token), addrspace)

    m_inttoptr = re.search(r"inttoptr\s*\(\s*i64\s+(-?\d+)\s+to\s+ptr", text)
    if m_inttoptr:
        return TypedValue(int(m_inttoptr.group(1)), addrspace)

    m_symbol = re.search(r"(%[-A-Za-z0-9_.$]+)\s*$", text)
    if m_symbol:
        return TypedValue(m_symbol.group(1), addrspace)

    m_int = re.search(r"(-?\d+)\s*$", text)
    if m_int:
        return TypedValue(int(m_int.group(1)), addrspace)

    raise SimError(f"cannot parse typed LLVM operand: {text!r}")


def parse_function_args(ir: str, entry: str) -> dict[str, int | None]:
    m = re.search(rf"define\s+.*?@{re.escape(entry)}\s*\((.*?)\)\s*(?:#[0-9]+\s*)?\{{", ir, re.S)
    if not m:
        raise SimError(f"entry function @{entry} not found")
    args: dict[str, int | None] = {}
    for arg in split_args(m.group(1)):
        tv = parse_typed_value(arg)
        if not isinstance(tv.value, str):
            continue
        args[tv.value] = tv.addrspace
    return args


def load_case(path: Path) -> dict[str, Any]:
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def build_buffers(case: dict[str, Any]) -> dict[str, Buffer]:
    buffers: dict[str, Buffer] = {}
    for name, cfg in case.get("buffers", {}).items():
        dtype = cfg.get("dtype", "f32")
        if dtype not in ("f32", "f16", "bf16", "u32", "s32", "u16", "s16", "u8", "s8"):
            raise SimError(
                f"buffer {name}: only f32/f16/bf16/u32/s32/u16/s16/u8/s8 are supported now, got {dtype}"
            )
        space = cfg.get("space", "ub")
        values = [round_dtype(x, dtype) for x in cfg.get("values", [])]
        size = cfg.get("size")
        if size is not None:
            if len(values) > size:
                raise SimError(f"buffer {name}: values longer than declared size")
            values = values + [0.0] * (size - len(values))
        buffers[name] = Buffer(name=name, values=values, dtype=dtype, space=space)
    if "__ub" not in buffers and "__ub_f32" not in buffers and "__ub_f16" not in buffers and "__ub_bf16" not in buffers:
        ub_size_bytes = int(case.get("ub_size_bytes", DEFAULT_UB_BYTES))
        ub_dtype = case.get("ub_dtype", "f32")
        configured_ub_dtypes = case.get("ub_dtypes")
        if configured_ub_dtypes is not None:
            ub_dtypes = tuple(configured_ub_dtypes)
        else:
            ub_dtypes = ("f32", "f16") if ub_dtype == "mixed" else (ub_dtype,)
        for dtype in ub_dtypes:
            if dtype not in ("f32", "f16", "bf16", "u32", "s32", "u16", "s16", "u8", "s8"):
                raise SimError(
                    f"ub_dtype: only f32/f16/bf16/u32/s32/u16/s16/u8/s8/mixed are supported now, got {ub_dtype}"
                )
            element_bytes = dtype_bytes(dtype)
            if ub_size_bytes % element_bytes != 0:
                raise SimError(f"ub_size_bytes must be divisible by {element_bytes} for {dtype}")
            name = "__ub" if len(ub_dtypes) == 1 else f"__ub_{dtype}"
            buffers[name] = Buffer(
                name=name,
                values=[0] * (ub_size_bytes // element_bytes),
                dtype=dtype,
                space="ub",
            )
    return buffers


def dtype_bytes(dtype: str) -> int:
    if dtype == "f32":
        return F32_BYTES
    if dtype in ("u32", "s32"):
        return I32_BYTES
    if dtype in ("u16", "s16"):
        return I16_BYTES
    if dtype == "f16":
        return F16_BYTES
    if dtype == "bf16":
        return BF16_BYTES
    if dtype in ("u8", "s8"):
        return I8_BYTES
    raise SimError(f"unsupported dtype {dtype}")


def f16(value: float) -> float:
    if math.isnan(value):
        return float("nan")
    try:
        return struct.unpack("e", struct.pack("e", value))[0]
    except OverflowError:
        return math.copysign(float("inf"), value)


def bf16(value: float) -> float:
    if math.isnan(value):
        return float("nan")
    packed = struct.pack("<f", f32(value))
    bits = struct.unpack("<I", packed)[0]
    rounded = bits + 0x7FFF + ((bits >> 16) & 1)
    bf16_bits = (rounded >> 16) & 0xFFFF
    return struct.unpack("<f", struct.pack("<I", bf16_bits << 16))[0]


def u32(value: int | float) -> int:
    return int(value) & 0xFFFFFFFF


def s32(value: int | float) -> int:
    raw = u32(value)
    return raw - 0x100000000 if raw >= 0x80000000 else raw


def u16(value: int | float) -> int:
    return int(value) & 0xFFFF


def s16(value: int | float) -> int:
    raw = u16(value)
    return raw - 0x10000 if raw >= 0x8000 else raw


def round_dtype(value: Any, dtype: str) -> int | float:
    if dtype == "f32":
        return f32(float(value))
    if dtype == "f16":
        return f16(float(value))
    if dtype == "bf16":
        return bf16(float(value))
    if dtype == "u32":
        return u32(value)
    if dtype == "s32":
        return s32(value)
    if dtype == "u16":
        return u16(value)
    if dtype == "s16":
        return s16(value)
    if dtype == "u8":
        return int(value) & 0xFF
    if dtype == "s8":
        raw = int(value) & 0xFF
        return raw - 256 if raw >= 128 else raw
    raise SimError(f"unsupported dtype {dtype}")


def u32_to_le_bytes(value: int | float) -> list[int]:
    raw = u32(value)
    return [(raw >> shift) & 0xFF for shift in (0, 8, 16, 24)]


def u16_to_le_bytes(value: int | float) -> list[int]:
    raw = u16(value)
    return [raw & 0xFF, (raw >> 8) & 0xFF]


def le_bytes_to_u32(values: list[int]) -> int:
    if len(values) != I32_BYTES:
        raise SimError(f"expected {I32_BYTES} bytes for u32 packing, got {len(values)}")
    raw = 0
    for idx, value in enumerate(values):
        raw |= (int(value) & 0xFF) << (idx * 8)
    return raw


def le_bytes_to_u16(values: list[int]) -> int:
    if len(values) != I16_BYTES:
        raise SimError(f"expected {I16_BYTES} bytes for u16 packing, got {len(values)}")
    return (int(values[0]) & 0xFF) | ((int(values[1]) & 0xFF) << 8)


def pack_u32_words_from_bytes(values: list[int]) -> list[int]:
    if len(values) % I32_BYTES != 0:
        raise SimError("byte payload length is not divisible by 4")
    return [le_bytes_to_u32(values[idx : idx + I32_BYTES]) for idx in range(0, len(values), I32_BYTES)]


def pack_u16_words_from_bytes(values: list[int]) -> list[int]:
    if len(values) % I16_BYTES != 0:
        raise SimError("byte payload length is not divisible by 2")
    return [le_bytes_to_u16(values[idx : idx + I16_BYTES]) for idx in range(0, len(values), I16_BYTES)]


def f32(value: float) -> float:
    if math.isnan(value):
        return float("nan")
    try:
        return struct.unpack("f", struct.pack("f", value))[0]
    except OverflowError:
        return math.copysign(float("inf"), value)


def f32_div(a: float, b: float) -> float:
    if math.isnan(a) or math.isnan(b):
        return float("nan")
    if b == 0.0:
        if a == 0.0:
            return float("nan")
        return math.copysign(float("inf"), a * b)
    return f32(a / b)


def f32_sqrt(value: float) -> float:
    if math.isnan(value):
        return float("nan")
    if value < 0.0:
        return float("nan")
    return f32(math.sqrt(value))


def f32_ln(value: float) -> float:
    if math.isnan(value):
        return float("nan")
    if value < 0.0:
        return float("nan")
    if value == 0.0:
        return float("-inf")
    return f32(math.log(value))


def f32_exp(value: float) -> float:
    if math.isnan(value):
        return float("nan")
    try:
        return f32(math.exp(value))
    except OverflowError:
        return float("inf")


def pattern_to_mask(pattern: int) -> list[bool]:
    # The simulator oracle confirms pattern 0 as full-lane for the current f32
    # milestone. Other pset encodings are intentionally fail-closed until their
    # lane semantics are proven against dav-3510 simulator logs.
    active_by_pattern = {
        0: 256,
        9: LANES_F32_V64,
    }
    if pattern not in active_by_pattern:
        raise SimError(f"unsupported pset pattern {pattern}")
    active = active_by_pattern[pattern]
    return [i < active for i in range(256)]


class DavVAddSim:
    def __init__(self, ir: str, case: dict[str, Any]) -> None:
        self.ir = ir
        self.case = case
        self.entry = case.get("entry", "dav_vadd")
        self.arg_spaces = parse_function_args(ir, self.entry)
        self.buffers = build_buffers(case)
        self.pointer_bindings = self._build_pointer_bindings()
        self.values: dict[str, Any] = {}
        for name, value in case.get("scalars", {}).items():
            self.values[name] = int(value)
        self.trace: list[str] = []
        self.unsupported: list[str] = []
        self.flags: set[tuple[int, int, int]] = set()
        self.dma_bytes = int(case.get("dma_bytes", VECTOR_BYTES_V64F32))

    def _build_pointer_bindings(self) -> dict[str, str]:
        explicit = self.case.get("arguments", {})
        bindings: dict[str, str] = {}
        for symbol, addrspace in self.arg_spaces.items():
            if addrspace is None:
                continue
            name = explicit.get(symbol, symbol.lstrip("%"))
            if name not in self.buffers:
                raise SimError(f"argument {symbol} maps to missing buffer {name!r}")
            if addrspace is not None and addrspace not in (GM_ADDRSPACE, UB_ADDRSPACE):
                raise SimError(
                    f"argument {symbol} uses addrspace({addrspace}); "
                    "only GM addrspace(1) and UB addrspace(6) are supported"
                )
            bindings[symbol] = name
        return bindings

    def _implicit_entry_label(self) -> str:
        numeric_args = [
            int(symbol[1:])
            for symbol in self.arg_spaces
            if symbol.startswith("%") and symbol[1:].isdigit()
        ]
        if numeric_args:
            return str(max(numeric_args) + 1)
        return "entry"

    def _resolve_pointer(
        self,
        ptr: TypedValue,
        expected_space: str,
        preferred_dtype: str | None = None,
    ) -> tuple[Buffer, int]:
        expected_addrspace = GM_ADDRSPACE if expected_space == "gm" else UB_ADDRSPACE
        if ptr.addrspace is not None and ptr.addrspace != expected_addrspace:
            raise SimError(
                f"pointer uses addrspace({ptr.addrspace}); expected "
                f"addrspace({expected_addrspace}) for {expected_space}"
            )
        if isinstance(ptr.value, int):
            if expected_space != "ub":
                raise SimError("integer pointer constants are only supported for UB")
            return self._default_ub_buffer(preferred_dtype), ptr.value
        bound = self.values.get(ptr.value)
        if isinstance(bound, PointerValue):
            if bound.addrspace != expected_addrspace:
                raise SimError(
                    f"pointer {ptr.value} resolves to addrspace({bound.addrspace}); "
                    f"expected addrspace({expected_addrspace})"
                )
            buf = self.buffers[bound.buffer]
            byte_offset = bound.byte_offset
        else:
            name = self.pointer_bindings.get(ptr.value)
            if not name:
                raise SimError(f"unbound pointer argument {ptr.value}")
            buf = self.buffers[name]
            byte_offset = 0
        if buf.space != expected_space:
            raise SimError(f"buffer {buf.name} is in {buf.space}; expected {expected_space}")
        return buf, byte_offset

    def _default_ub_buffer(self, preferred_dtype: str | None) -> Buffer:
        if preferred_dtype:
            typed_name = f"__ub_{preferred_dtype}"
            if typed_name in self.buffers:
                return self.buffers[typed_name]
        if "__ub" in self.buffers:
            return self.buffers["__ub"]
        if preferred_dtype:
            raise SimError(f"UB has no {preferred_dtype} view")
        if "__ub_f32" in self.buffers:
            return self.buffers["__ub_f32"]
        raise SimError("UB buffer is missing")

    def _check_region(
        self,
        buf: Buffer,
        byte_offset: int,
        byte_count: int,
        op: str,
        alignment: int = ALIGNMENT_BYTES,
    ) -> int:
        if byte_offset < 0:
            raise SimError(f"{op} on {buf.name}: negative byte offset {byte_offset}")
        if alignment <= 0:
            raise SimError(f"{op} on {buf.name}: invalid alignment {alignment}")
        if byte_offset % alignment != 0:
            raise SimError(
                f"{op} on {buf.name}: byte offset {byte_offset} is not "
                f"{alignment}-byte aligned"
            )
        element_bytes = dtype_bytes(buf.dtype)
        if byte_offset % element_bytes != 0:
            raise SimError(f"{op} on {buf.name}: byte offset is not {buf.dtype} aligned")
        if byte_count % element_bytes != 0:
            raise SimError(f"{op} on {buf.name}: byte count is not {buf.dtype} aligned")
        start = byte_offset // element_bytes
        end = start + byte_count // element_bytes
        if end > len(buf.values):
            raise SimError(
                f"{op} on {buf.name}: memory overflow, needs elements "
                f"[{start}, {end}), buffer has {len(buf.values)}"
            )
        return start

    def _copy_typed(
        self,
        src: Buffer,
        src_byte_offset: int,
        dst: Buffer,
        dst_byte_offset: int,
        byte_count: int,
        op: str,
    ) -> None:
        if src.dtype != dst.dtype:
            raise SimError(f"{op}: dtype mismatch {src.dtype} -> {dst.dtype}")
        src_start = self._check_region(src, src_byte_offset, byte_count, op + " read")
        dst_start = self._check_region(dst, dst_byte_offset, byte_count, op + " write")
        count = byte_count // dtype_bytes(src.dtype)
        dst.values[dst_start : dst_start + count] = src.values[src_start : src_start + count]

    def _read_ub_bytes(self, buf: Buffer, byte_offset: int, byte_count: int, op: str) -> list[int]:
        if buf.dtype not in ("u8", "s8"):
            raise SimError(f"{op}: expected byte UB buffer, got {buf.dtype}")
        start = self._check_region(buf, byte_offset, byte_count, op, alignment=1)
        return [int(x) & 0xFF for x in buf.values[start : start + byte_count]]

    def _mirror_u32_vector_to_u8_view(
        self,
        byte_offset: int,
        vec: list[int | None],
        mask: list[bool],
        op: str,
    ) -> None:
        byte_view = self.buffers.get("__ub_u8")
        if byte_view is None:
            return
        start = self._check_region(byte_view, byte_offset, VECTOR_BYTES_V64I32, op, alignment=1)
        for idx, active in enumerate(mask):
            if not active:
                continue
            value = vec[idx]
            if value is None:
                raise SimError(f"{op}: stores inactive/undefined lane {idx}")
            word_start = start + idx * I32_BYTES
            byte_view.values[word_start : word_start + I32_BYTES] = u32_to_le_bytes(value)

    def _mirror_u16_vector_to_u8_view(
        self,
        byte_offset: int,
        vec: list[int | None],
        mask: list[bool],
        op: str,
    ) -> None:
        byte_view = self.buffers.get("__ub_u8")
        if byte_view is None:
            return
        start = self._check_region(byte_view, byte_offset, VECTOR_BYTES_V128I16, op, alignment=1)
        for idx, active in enumerate(mask):
            if not active:
                continue
            value = vec[idx]
            if value is None:
                raise SimError(f"{op}: stores inactive/undefined lane {idx}")
            word_start = start + idx * I16_BYTES
            byte_view.values[word_start : word_start + I16_BYTES] = u16_to_le_bytes(value)

    def run(self) -> None:
        instructions, labels = self._parse_function_body()
        current_label = "entry" if "entry" in labels else self._implicit_entry_label()
        pc = labels.get(current_label, 0)
        last_block = current_label
        steps = 0
        max_steps = int(self.case.get("max_steps", 100000))
        while pc < len(instructions):
            steps += 1
            if steps > max_steps:
                raise SimError(f"execution exceeded max_steps={max_steps}")
            line = instructions[pc]
            if line == "ret void" or line.startswith("ret "):
                break
            phi = self._try_execute_phi(line, last_block)
            if phi:
                pc += 1
                continue
            branch = self._execute_branch(line)
            if branch is not None:
                next_label = branch
                if next_label not in labels:
                    raise SimError(f"branch targets unknown label %{next_label}")
                last_block = current_label
                current_label = next_label
                pc = labels[next_label]
                continue
            self._execute_line(line)
            pc += 1

        if self.unsupported:
            uniq = sorted(set(self.unsupported))
            raise SimError("unsupported llvm.hivm intrinsic(s): " + ", ".join(uniq))

    def _parse_function_body(self) -> tuple[list[str], dict[str, int]]:
        m = re.search(
            rf"define\s+.*?@{re.escape(self.entry)}\s*\(.*?\)\s*(?:#[0-9]+\s*)?\{{",
            self.ir,
            re.S,
        )
        if not m:
            raise SimError(f"entry function @{self.entry} not found")
        body_text = self.ir[m.end() :]
        body_text = body_text.split("\n}", 1)[0]
        instructions: list[str] = []
        implicit_entry = self._implicit_entry_label()
        labels: dict[str, int] = {implicit_entry: 0}
        for raw in body_text.splitlines():
            line = strip_comment(raw)
            if not line:
                continue
            label = re.match(r"^([A-Za-z0-9_.$-]+):$", line)
            if label:
                labels[label.group(1).lstrip("%")] = len(instructions)
                continue
            if line.startswith("declare "):
                continue
            instructions.append(line)
        return instructions, labels

    def _execute_branch(self, line: str) -> str | None:
        unconditional = re.match(r"br\s+label\s+%?([A-Za-z0-9_.$-]+)$", line)
        if unconditional:
            return unconditional.group(1)
        conditional = re.match(
            r"br\s+i1\s+([^,]+),\s+label\s+%?([A-Za-z0-9_.$-]+),\s+label\s+%?([A-Za-z0-9_.$-]+)$",
            line,
        )
        if conditional:
            cond = self._as_bool(parse_typed_value(conditional.group(1)), "branch condition")
            return conditional.group(2) if cond else conditional.group(3)
        return None

    def _try_execute_phi(self, line: str, last_block: str) -> bool:
        m = re.match(r"(%[-A-Za-z0-9_.$]+)\s*=\s*phi\s+\S+\s+(.+)$", line)
        if not m:
            return False
        lhs = m.group(1)
        incoming = re.findall(r"\[\s*([^,\]]+)\s*,\s+%?([A-Za-z0-9_.$-]+)\s*\]", m.group(2))
        for value_text, label in incoming:
            if label == last_block:
                self.values[lhs] = self._read_scalar_or_pointer(parse_typed_value(value_text))
                self.trace.append(f"{lhs} = phi({label})")
                return True
        raise SimError(f"{lhs}: no phi incoming edge for %{last_block}")

    def _execute_line(self, line: str) -> None:
        if line.startswith("declare "):
            return

        if self._execute_scalar_or_pointer_line(line):
            return

        generic_call = re.search(
            r"(?:(%[-A-Za-z0-9_.$]+)\s*=\s*)?call\s+.*?(@llvm\.[^(]+)\((.*)\)",
            line,
        )
        if generic_call and not generic_call.group(2).startswith("@llvm.hivm."):
            self._execute_generic_call(generic_call.group(1), generic_call.group(2), generic_call.group(3))
            return

        call = re.search(r"(?:(%[-A-Za-z0-9_.$]+)\s*=\s*)?call\s+.*?(@llvm\.hivm\.[^(]+)\((.*)\)", line)
        if not call:
            if "@llvm.hivm." in line:
                m = re.search(r"@llvm\.hivm\.[A-Za-z0-9_.$]+", line)
                if m:
                    self.unsupported.append(m.group(0))
            return

        lhs = call.group(1)
        name = call.group(2)
        args = [parse_typed_value(a) for a in split_args(call.group(3))]

        if name in ("@llvm.hivm.plt.b16.v300", "@llvm.hivm.plt.b32.v300"):
            if lhs is None:
                raise SimError("plt result is unused")
            if len(args) != 1:
                raise SimError(f"{name}: expected 1 arg, got {len(args)}")
            lanes = LANES_F16_V128 if name.endswith(".b16.v300") else LANES_F32_V64
            active = self._as_int(args[0], "plt active lanes")
            if active < 0 or active > lanes:
                raise SimError(f"{name}: active lane count {active} out of range for {lanes} lanes")
            mask = [idx < active for idx in range(lanes)] + [False] * (256 - lanes)
            self.values[lhs] = AggregateValue([mask, active])
            self.trace.append(f"{lhs} = {name.rsplit('.', 2)[-2]}({active})")
            return

        if name == "@llvm.hivm.pset.b8":
            if lhs is None:
                raise SimError("pset result is unused")
            pattern = self._as_int(args[0], "pset pattern")
            if pattern != 0:
                raise SimError("pset.b8 milestone supports full-active pattern 0 only")
            self.values[lhs] = self._predicate_b8_full_active()
            self.trace.append(f"{lhs} = pset.b8({pattern})")
            return

        if name in ("@llvm.hivm.pset.b32", "@llvm.hivm.pset.b16"):
            if lhs is None:
                raise SimError("pset result is unused")
            pattern = self._as_int(args[0], "pset pattern")
            self.values[lhs] = pattern_to_mask(pattern)
            self.trace.append(f"{lhs} = {name.rsplit('.', 1)[-1]}({pattern})")
            return

        if name == "@llvm.hivm.GET.CTRL":
            if lhs is None:
                raise SimError("GET.CTRL result is unused")
            self.values[lhs] = 0
            self.trace.append(f"{lhs} = GET.CTRL()")
            return

        if name == "@llvm.hivm.GET.BLOCK.IDX":
            if lhs is None:
                raise SimError("GET.BLOCK.IDX result is unused")
            self.values[lhs] = int(self.case.get("block_idx", 0))
            self.trace.append(f"{lhs} = GET.BLOCK.IDX()")
            return

        if name == "@llvm.hivm.SBITSET0":
            if lhs is None:
                raise SimError("SBITSET0 result is unused")
            self.values[lhs] = self._as_int(args[0], "SBITSET0 value")
            self.trace.append(f"{lhs} = SBITSET0({args[0].value}, {args[1].value})")
            return

        if name == "@llvm.hivm.SBITSET1":
