            return

        if name in ("@llvm.hivm.pstu.b16", "@llvm.hivm.pstu.b32"):
            if lhs is None:
                raise SimError("pstu result is unused")
            if len(args) != 3:
                raise SimError(f"{name}: expected 3 args, got {len(args)}")
            lanes = LANES_F16_V128 if name.endswith(".b16") else LANES_F32_V64
            mask = self._as_mask(args[0], "pstu predicate", lanes=lanes)
            buf, base_byte = self._resolve_pointer(args[1], "ub", preferred_dtype="u8")
            align = self._as_align_data(args[2], "pstu align data")
            packed = self._pack_prefix_mask(mask, lanes, name)
            start = self._check_region(buf, base_byte, len(packed), name, alignment=1)
            for idx, value in enumerate(packed):
                buf.values[start + idx] = round_dtype(value, buf.dtype)
            next_ptr = PointerValue(buf.name, UB_ADDRSPACE, base_byte + len(packed))
            self.values[lhs] = AggregateValue([align, next_ptr])
            self.trace.append(f"{lhs} = {name.rsplit('.', 1)[-1]}(UB, byte_offset={base_byte})")
            return

        if name == "@llvm.hivm.vstas":
            if len(args) != 4:
                raise SimError(f"{name}: expected 4 args, got {len(args)}")
            self._as_align_data(args[0], "vstas align data")
            self._resolve_pointer(args[1], "ub", preferred_dtype="u8")
            mode = self._as_int(args[2], "vstas mode")
            postupdate = self._as_int(args[3], "vstas postupdate")
            if mode != 0 or postupdate != 0:
                raise SimError("vstas milestone supports mode=0 and postupdate=0 only")
            self.trace.append(f"vstas({args[0].value}, {args[1].value})")
            return

        self.unsupported.append(name)

    def _map_unary_vector(
        self,
        vec: list[float | None],
        mask: list[bool],
        op: Callable[[float], float],
    ) -> list[float | None]:
        result: list[float | None] = []
        for idx, active in enumerate(mask):
            result.append(op(float(vec[idx])) if active else None)
        return result

    def _inactive_lane(self, mode: str, merge_value: float | None) -> float | None:
        if mode == "x":
            return None
        if mode == "z":
            return 0.0
        if mode == "m":
            if merge_value is None:
                raise SimError("merge mode reads an inactive source lane")
            return float(merge_value)
        raise SimError(f"unsupported vector mode {mode!r}")

    def _map_binary_vector(
        self,
        left: list[float | None],
        right: list[float | None],
        mask: list[bool],
        mode: str,
        op: Callable[[float, float], float],
    ) -> list[float | None]:
        result: list[float | None] = []
        for idx, active in enumerate(mask):
            if active:
                result.append(op(float(left[idx]), float(right[idx])))
            else:
                result.append(self._inactive_lane(mode, left[idx]))
        return result

    def _map_scalar_vector(
        self,
        vec: list[float | None],
        scalar: float,
        mask: list[bool],
        mode: str,
        op: Callable[[float, float], float],
    ) -> list[float | None]:
        result: list[float | None] = []
        for idx, active in enumerate(mask):
            if active:
                result.append(op(float(vec[idx]), scalar))
            else:
                result.append(self._inactive_lane(mode, vec[idx]))
        return result

    def _map_ternary_vector(
        self,
        dst: list[float | None],
        left: list[float | None],
        right: list[float | None],
        mask: list[bool],
        mode: str,
        op: Callable[[float, float, float], float],
    ) -> list[float | None]:
        result: list[float | None] = []
        for idx, active in enumerate(mask):
            if active:
                result.append(op(float(dst[idx]), float(left[idx]), float(right[idx])))
            else:
                result.append(self._inactive_lane(mode, dst[idx]))
        return result

    def _map_vector_vector_scalar(
        self,
        dst: list[float | None],
        src: list[float | None],
        scalar: float,
        mask: list[bool],
        mode: str,
        op: Callable[[float, float, float], float],
    ) -> list[float | None]:
        result: list[float | None] = []
        for idx, active in enumerate(mask):
            if active:
                result.append(op(float(dst[idx]), float(src[idx]), scalar))
            else:
                result.append(self._inactive_lane(mode, dst[idx]))
        return result

    def _vmulscvt_f16(
        self,
        src: list[float | None],
        scalar: float,
        mask: list[bool],
        part: int,
    ) -> list[float | None]:
        if part not in (0, 1):
            raise SimError("vmulscvt milestone supports part=0/1 only")
        result: list[float | None] = [0.0] * LANES_F16_V128
        for idx, active in enumerate(mask):
            dst_lane = idx * 2 + part
            if dst_lane >= LANES_F16_V128:
                break
            if active:
                result[dst_lane] = f16(f32(float(src[idx]) * scalar))
        return result

    def _map_select_vector(
        self,
        left: list[float | None],
        right: list[float | None],
        pred: list[bool],
    ) -> list[float | None]:
        result: list[float | None] = []
        for idx, active in enumerate(pred):
            selected = left[idx] if active else right[idx]
            if selected is None:
                raise SimError(f"vsel reads inactive source lane {idx}")
            result.append(f32(float(selected)))
        return result

    def _map_select_i32(
        self,
        left: list[int | None],
        right: list[int | None],
        pred: list[bool],
    ) -> list[int | None]:
        result: list[int | None] = []
        for idx, active in enumerate(pred):
            selected = left[idx] if active else right[idx]
            if selected is None:
                raise SimError(f"vsel reads inactive source lane {idx}")
            result.append(u32(selected))
        return result

    def _addc_u32(
        self,
        left: list[int | None],
        right: list[int | None],
        mask: list[bool],
    ) -> tuple[list[int | None], list[bool]]:
        values: list[int | None] = []
        pred: list[bool] = []
        for idx, active in enumerate(mask):
            if not active:
                values.append(None)
                pred.append(False)
                continue
            total = u32(left[idx]) + u32(right[idx])
            values.append(u32(total))
            pred.append(total > 0xFFFFFFFF)
        return values, pred

    def _subc_u32(
        self,
        left: list[int | None],
        right: list[int | None],
        mask: list[bool],
    ) -> tuple[list[int | None], list[bool]]:
        values: list[int | None] = []
        pred: list[bool] = []
        for idx, active in enumerate(mask):
            if not active:
                values.append(None)
                pred.append(False)
                continue
            lhs = u32(left[idx])
            rhs = u32(right[idx])
            values.append(u32(lhs - rhs))
            pred.append(lhs >= rhs)
        return values, pred

    def _addcs_u32(
        self,
        left: list[int | None],
        right: list[int | None],
        carry_in: list[bool],
        mask: list[bool],
    ) -> tuple[list[int | None], list[bool]]:
        values: list[int | None] = []
        pred: list[bool] = []
        for idx, active in enumerate(mask):
            if not active:
                values.append(None)
                pred.append(False)
                continue
            total = u32(left[idx]) + u32(right[idx]) + (1 if carry_in[idx] else 0)
            values.append(u32(total))
            pred.append(total > 0xFFFFFFFF)
        return values, pred

    def _subcs_u32(
        self,
        left: list[int | None],
        right: list[int | None],
        carry_in: list[bool],
        mask: list[bool],
    ) -> tuple[list[int | None], list[bool]]:
        values: list[int | None] = []
        pred: list[bool] = []
        for idx, active in enumerate(mask):
            if not active:
                values.append(None)
                pred.append(False)
                continue
            lhs = u32(left[idx])
            rhs = u32(right[idx])
            borrow_in = 0 if carry_in[idx] else 1
            total_rhs = rhs + borrow_in
            values.append(u32(lhs - total_rhs))
            pred.append(lhs >= total_rhs)
        return values, pred

    def _map_diff_exp_vector(
        self,
        left: list[float | None],
        right: list[float | None],
        mask: list[bool],
    ) -> list[float | None]:
        if not all(mask):
            raise SimError("vexpdif milestone supports full mask only")
        result: list[float | None] = []
        for idx in range(LANES_F32_V64):
            if left[idx] is None or right[idx] is None:
                raise SimError(f"vexpdif reads inactive source lane {idx}")
            result.append(f32_exp(f32(float(left[idx]) - float(right[idx]))))
        return result

    def _reduce_vector(
        self,
        vec: list[float | None],
        mask: list[bool],
        op_label: str,
    ) -> list[float | None]:
        if not all(mask):
            raise SimError(f"{op_label} milestone supports full mask only")
        values: list[float] = []
        for idx in range(LANES_F32_V64):
            if vec[idx] is None:
                raise SimError(f"{op_label} reads inactive source lane {idx}")
            values.append(float(vec[idx]))
        if op_label == "vcadd":
            result = 0.0
            for value in values:
                result = f32(result + value)
        elif op_label == "vcmax":
            result = f32(max(values))
        elif op_label == "vcmin":
            result = f32(min(values))
        else:
            raise SimError(f"unsupported reduction op {op_label}")
        return [result] + [0.0] * (LANES_F32_V64 - 1)

    def _predicate_b8_full_active(self) -> PredicateBytes:
        values = [0] * PREDICATE_BYTES_B8
        values[:B8_FULL_ACTIVE_STORED_BYTES] = [0xFF] * B8_FULL_ACTIVE_STORED_BYTES
        return PredicateBytes(values)

    def _pack_prefix_mask(self, mask: list[bool], lanes: int, op_label: str) -> list[int]:
        active = 0
        while active < lanes and mask[active]:
            active += 1
        if any(mask[active:lanes]):
            raise SimError(f"{op_label}: milestone supports prefix-active predicates only")
        packed: list[int] = []
        for byte_base in range(0, lanes, 8):
            value = 0
            for bit in range(8):
                if mask[byte_base + bit]:
                    value |= 1 << bit
            packed.append(value)
        return packed

    def _execute_scalar_or_pointer_line(self, line: str) -> bool:
        shufflevector = re.match(
            r"(%[-A-Za-z0-9_.$]+)\s*=\s*shufflevector\s+<64 x float>\s+([^,]+),\s+<64 x float>\s+([^,]+),\s+<128 x i32>\s+<(.+)>$",
            line,
        )
        if shufflevector:
            lhs = shufflevector.group(1)
            left = self._as_vector(parse_typed_value(shufflevector.group(2)), "shufflevector lhs")
            right = self._as_vector(parse_typed_value(shufflevector.group(3)), "shufflevector rhs")
            indices = [int(item) for item in re.findall(r"i32\s+(-?\d+)", shufflevector.group(4))]
            if len(indices) != LANES_F32_V128:
                raise SimError(f"{lhs}: expected {LANES_F32_V128} shufflevector indices")
            combined: list[float | None] = []
            for index in indices:
                if index < 0 or index >= LANES_F32_V128:
                    raise SimError(f"{lhs}: shufflevector index {index} out of range")
                combined.append(left[index] if index < LANES_F32_V64 else right[index - LANES_F32_V64])
            self.values[lhs] = combined
            self.trace.append(f"{lhs} = shufflevector({shufflevector.group(2)}, {shufflevector.group(3)})")
            return True

        extractvalue = re.match(
            r"(%[-A-Za-z0-9_.$]+)\s*=\s*extractvalue\s+\{.*\}\s+(%[-A-Za-z0-9_.$]+),\s+(\d+)$",
            line,
        )
        if extractvalue:
            lhs = extractvalue.group(1)
            aggregate_name = extractvalue.group(2)
            index = int(extractvalue.group(3))
            aggregate = self.values.get(aggregate_name)
            if not isinstance(aggregate, AggregateValue):
                raise SimError(f"{lhs}: expected aggregate value {aggregate_name}")
            if index < 0 or index >= len(aggregate.elements):
                raise SimError(f"{lhs}: aggregate index {index} out of range")
            element = aggregate.elements[index]
            self.values[lhs] = list(element) if isinstance(element, list) else element
            self.trace.append(f"{lhs} = extractvalue({aggregate_name}, {index})")
            return True

        ptrtoint = re.match(
            r"(%[-A-Za-z0-9_.$]+)\s*=\s*ptrtoint\s+(ptr(?:\s+addrspace\(\d+\))?\s+%[-A-Za-z0-9_.$]+)\s+to\s+i\d+$",
            line,
        )
        if ptrtoint:
            lhs = ptrtoint.group(1)
            ptr = parse_typed_value(ptrtoint.group(2))
            expected_space = "gm" if ptr.addrspace == GM_ADDRSPACE else "ub"
            buf, byte_offset = self._resolve_pointer(ptr, expected_space)
            self.values[lhs] = PointerValue(buf.name, ptr.addrspace or GM_ADDRSPACE, byte_offset)
            self.trace.append(f"{lhs} = ptrtoint({buf.name}+{byte_offset})")
            return True

        inttoptr = re.match(
            r"(%[-A-Za-z0-9_.$]+)\s*=\s*inttoptr\s+i\d+\s+(.+?)\s+to\s+ptr(?:\s+addrspace\((\d+)\))?$",
            line,
        )
        if inttoptr:
            lhs = inttoptr.group(1)
            addrspace = int(inttoptr.group(3)) if inttoptr.group(3) else None
            raw = self._read_scalar_or_pointer(parse_typed_value(inttoptr.group(2)))
            if isinstance(raw, PointerValue):
                self.values[lhs] = PointerValue(raw.buffer, addrspace or raw.addrspace, raw.byte_offset)
            elif isinstance(raw, int):
                if addrspace != UB_ADDRSPACE:
                    raise SimError("integer inttoptr is only supported for UB pointers")
                self.values[lhs] = PointerValue("__ub", addrspace, raw)
            else:
                raise SimError(f"{lhs}: cannot inttoptr {raw!r}")
            self.trace.append(f"{lhs} = inttoptr(...)")
            return True

        cast = re.match(r"(%[-A-Za-z0-9_.$]+)\s*=\s*(?:trunc|sext)\s+i\d+\s+(.+?)\s+to\s+i\d+$", line)
        if cast:
            self.values[cast.group(1)] = self._as_int(parse_typed_value(cast.group(2)), "integer cast")
            return True

        binary = re.match(
            r"(%[-A-Za-z0-9_.$]+)\s*=\s*(add|sub|mul|and|or|shl)\s+i\d+\s+([^,]+),\s+(.+)$",
            line,
        )
        if binary:
            lhs, op = binary.group(1), binary.group(2)
            left = self._read_scalar_or_pointer(parse_typed_value(binary.group(3)))
            right = self._read_scalar_or_pointer(parse_typed_value(binary.group(4)))
            self.values[lhs] = self._eval_binary(op, left, right, lhs)
            return True

        icmp = re.match(r"(%[-A-Za-z0-9_.$]+)\s*=\s*icmp\s+(sle|slt)\s+i\d+\s+([^,]+),\s+(.+)$", line)
        if icmp:
            lhs = icmp.group(1)
            left = self._as_int(parse_typed_value(icmp.group(3)), "icmp lhs")
            right = self._as_int(parse_typed_value(icmp.group(4)), "icmp rhs")
            self.values[lhs] = left <= right if icmp.group(2) == "sle" else left < right
            return True

        return False

    def _dma_out_byte_count(self, descriptor: TypedValue) -> int:
        raw = self._as_int(descriptor, "MOV.UB.TO.OUT descriptor")
        encoded = (raw >> 25) & 0x1FFFFF
        if encoded == 0 and not self.case.get("allow_zero_dma", False):
            raise SimError("MOV.UB.TO.OUT: zero-length DMA burst is illegal")
        return encoded or self.dma_bytes

    def _execute_generic_call(self, lhs: str | None, name: str, arg_text: str) -> None:
        args = [parse_typed_value(a) for a in split_args(arg_text)]
        if name == "@llvm.smax.i32":
            if lhs is None:
                raise SimError("smax result is unused")
            self.values[lhs] = max(self._as_int(args[0], "smax lhs"), self._as_int(args[1], "smax rhs"))
            return
        if name == "@llvm.smin.i32":
            if lhs is None:
                raise SimError("smin result is unused")
            self.values[lhs] = min(self._as_int(args[0], "smin lhs"), self._as_int(args[1], "smin rhs"))
            return
        raise SimError(f"unsupported LLVM intrinsic {name}")

    def _eval_binary(
        self, op: str, left: int | PointerValue, right: int | PointerValue, lhs: str
    ) -> int | PointerValue:
        if isinstance(left, PointerValue) or isinstance(right, PointerValue):
            if op not in ("add", "sub"):
                raise SimError(f"{lhs}: pointer arithmetic only supports add/sub")
            if isinstance(left, PointerValue) and isinstance(right, int):
                delta = right if op == "add" else -right
                return PointerValue(left.buffer, left.addrspace, left.byte_offset + delta)
            if op == "add" and isinstance(right, PointerValue) and isinstance(left, int):
                return PointerValue(right.buffer, right.addrspace, right.byte_offset + left)
            raise SimError(f"{lhs}: invalid pointer arithmetic operands")
        if op == "add":
            return left + right
        if op == "sub":
            return left - right
        if op == "mul":
            return left * right
        if op == "and":
            return left & right
        if op == "or":
            return left | right
        if op == "shl":
            return left << right
        raise SimError(f"{lhs}: unsupported binary op {op}")

    def _read_scalar_or_pointer(self, value: TypedValue) -> int | float | bool | PointerValue:
        if isinstance(value.value, int):
            return value.value
        if isinstance(value.value, float):
            return value.value
        if value.value not in self.values:
            raise SimError(f"unknown SSA value {value.value}")
        bound = self.values[value.value]
        if isinstance(bound, (int, float, bool, PointerValue)):
            return bound
        raise SimError(f"{value.value}: expected scalar or pointer, got vector/mask")

    def _as_int(self, value: TypedValue, label: str) -> int:
        if isinstance(value.value, int):
            return value.value
        bound = self.values.get(value.value)
        if isinstance(bound, int):
            return bound
        raise SimError(f"{label}: expected integer, got {value.value}")

    def _as_float(self, value: TypedValue, label: str) -> float:
        if isinstance(value.value, (int, float)):
            return f32(float(value.value))
        bound = self.values.get(value.value)
        if isinstance(bound, (int, float)):
            return f32(float(bound))
        raise SimError(f"{label}: expected float, got {value.value}")

    def _as_bool(self, value: TypedValue, label: str) -> bool:
        if isinstance(value.value, int):
            return bool(value.value)
        bound = self.values.get(value.value)
        if isinstance(bound, bool):
            return bound
        raise SimError(f"{label}: expected i1, got {value.value}")

    def _as_vector(
        self,
        value: TypedValue,
        label: str,
        allow_inactive: bool = False,
        lanes: int = LANES_F32_V64,
    ) -> list[int | float | None]:
        if not isinstance(value.value, str) or value.value not in self.values:
            raise SimError(f"{label}: unknown vector {value.value}")
        vec = self.values[value.value]
        if not isinstance(vec, list) or len(vec) != lanes:
            raise SimError(f"{label}: expected vector<{lanes}>")
        if not allow_inactive and any(x is None for x in vec):
            raise SimError(f"{label}: vector contains inactive lanes")
        return vec

    def _as_u32_vector(
        self,
        value: TypedValue,
        label: str,
        allow_inactive: bool = False,
        lanes: int = LANES_I32_V64,
    ) -> list[int | None]:
        vec = self._as_vector(value, label, allow_inactive=allow_inactive, lanes=lanes)
        result: list[int | None] = []
        for idx, item in enumerate(vec):
            if item is None:
                result.append(None)
                continue
            if isinstance(item, bool):
                raise SimError(f"{label}: lane {idx} is not an i32 value")
            result.append(u32(item))
        return result

    def _as_u16_vector(
        self,
        value: TypedValue,
        label: str,
        allow_inactive: bool = False,
        lanes: int = LANES_I16_V128,
    ) -> list[int | None]:
        vec = self._as_vector(value, label, allow_inactive=allow_inactive, lanes=lanes)
        result: list[int | None] = []
        for idx, item in enumerate(vec):
            if item is None:
                result.append(None)
                continue
            if isinstance(item, bool):
                raise SimError(f"{label}: lane {idx} is not an i16 value")
            result.append(u16(item))
        return result

    def _as_u8_vector(
        self,
        value: TypedValue,
        label: str,
        allow_inactive: bool = False,
        lanes: int = LANES_I8_V256,
    ) -> list[int | None]:
        vec = self._as_vector(value, label, allow_inactive=allow_inactive, lanes=lanes)
        result: list[int | None] = []
        for idx, item in enumerate(vec):
            if item is None:
                result.append(None)
                continue
            if isinstance(item, bool):
                raise SimError(f"{label}: lane {idx} is not an i8 value")
            result.append(int(item) & 0xFF)
        return result

    def _as_mask(self, value: TypedValue, label: str, lanes: int = LANES_F32_V64) -> list[bool]:
        if not isinstance(value.value, str) or value.value not in self.values:
            raise SimError(f"{label}: unknown mask {value.value}")
        mask = self.values[value.value]
        if isinstance(mask, PredicateBytes):
            if lanes != LANES_I8_V256:
                raise SimError(f"{label}: b8 predicate can only feed 256-lane byte masks")
            if mask.values[:B8_FULL_ACTIVE_STORED_BYTES] != [0xFF] * B8_FULL_ACTIVE_STORED_BYTES:
                raise SimError(f"{label}: unsupported b8 predicate payload")
            return [True] * LANES_I8_V256
        if not isinstance(mask, list) or len(mask) < lanes:
            raise SimError(f"{label}: expected predicate mask")
        sliced = mask[:lanes]
        if not all(isinstance(x, bool) for x in sliced):
            raise SimError(f"{label}: expected predicate mask")
        return sliced

    def _as_predicate_bytes(self, value: TypedValue, label: str) -> PredicateBytes:
        if not isinstance(value.value, str) or value.value not in self.values:
            raise SimError(f"{label}: unknown predicate {value.value}")
        pred = self.values[value.value]
        if not isinstance(pred, PredicateBytes) or len(pred.values) != PREDICATE_BYTES_B8:
            raise SimError(f"{label}: expected b8 predicate payload")
        return pred

    def _as_align_data(self, value: TypedValue, label: str) -> AlignData:
        if not isinstance(value.value, str) or value.value not in self.values:
            raise SimError(f"{label}: unknown align data {value.value}")
        align = self.values[value.value]
        if not isinstance(align, AlignData) or len(align.values) != PREDICATE_BYTES_B8:
            raise SimError(f"{label}: expected vector<32xi8> align data")
        return align

    def check(self) -> tuple[bool, list[str]]:
        failures: list[str] = []
        for check in self.case.get("checks", []):
            name = check["buffer"]
            buf = self.buffers.get(name)
            if buf is None:
                failures.append(f"missing check buffer {name}")
                continue
            golden = [float(x) for x in check.get("golden", [])]
            offset = int(check.get("offset", 0))
            atol = float(check.get("atol", 0.0))
            rtol = float(check.get("rtol", 0.0))
            actual = buf.values[offset : offset + len(golden)]
            if len(actual) != len(golden):
                failures.append(f"{name}: actual slice shorter than golden")
                continue
            max_abs = 0.0
            bad_at = None
            for idx, (a, g) in enumerate(zip(actual, golden)):
                diff = abs(a - g)
                max_abs = max(max_abs, diff)
                if math.isnan(a) != math.isnan(g) or diff > atol + rtol * abs(g):
                    bad_at = idx
                    break
            if bad_at is not None:
                failures.append(
                    f"{name}: mismatch at element {offset + bad_at}: "
                    f"actual={actual[bad_at]} golden={golden[bad_at]}"
                )
            else:
                self.trace.append(f"check {name}[{offset}:{offset + len(golden)}] max_abs={max_abs}")
        return not failures, failures


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Run a minimal dav LLVM IR simulation")
    parser.add_argument("ir", type=Path, help="LLVM IR .ll file")
    parser.add_argument("--case", required=True, type=Path, help="JSON case file")
    parser.add_argument("--trace", action="store_true", help="print executed simulated ops")
    args = parser.parse_args(argv)

    try:
        ir = args.ir.read_text(encoding="utf-8")
        case = load_case(args.case)
        sim = DavVAddSim(ir, case)
        sim.run()
        ok, failures = sim.check()
        if args.trace:
            for item in sim.trace:
                print(item)
        if ok:
            print("ASC-SIM PASS")
            return 0
        for failure in failures:
            print(f"ASC-SIM CHECK FAILED: {failure}", file=sys.stderr)
        return 1
    except SimError as e:
        print(f"ASC-SIM ERROR: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
