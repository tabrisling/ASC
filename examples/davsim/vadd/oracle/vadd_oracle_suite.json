{
  "schema_version": 1,
  "description": "dav vadd checks that compare ASC local modeling with OpenTileAS simulator oracle coverage.",
  "asc_cases": [
    {
      "name": "gm_ub_register_vadd_64",
      "ir": "../vadd.ll",
      "case": "../vadd.case.json",
      "expect_asc_status": "pass"
    },
    {
      "name": "special_f32_values_64",
      "ir": "../vadd.ll",
      "case": "../vadd.case.json",
