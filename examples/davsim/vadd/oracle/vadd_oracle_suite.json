    {
      "name": "float32_overflow_to_inf_64",
      "ir": "../vadd.ll",
      "case": "../vadd.case.json",
      "expect_asc_status": "pass",
      "generated": "float32_overflow_64"
    },
    {
      "name": "unsupported_f16_input",
      "ir": "../vadd.ll",
      "case": "../vadd.case.json",
      "expect_asc_status": "error",
      "case_overrides": {
        "buffers": {
          "a": {
            "dtype": "f16"
          }
        }
      }
    },
    {
      "name": "unsupported_bf16_input",
      "ir": "../vadd.ll",
