          "a": {
            "dtype": "bf16"
          }
        }
      }
    },
    {
      "name": "unsupported_int32_input",
      "ir": "../vadd.ll",
      "case": "../vadd.case.json",
      "expect_asc_status": "error",
      "case_overrides": {
        "buffers": {
          "a": {
            "dtype": "int32"
          }
        }
      }
    },
    {
      "name": "gm_to_ub_misaligned_dst",
      "ir": "../vadd.ll",
      "case": "../vadd.case.json",
      "expect_asc_status": "error",
      "replacements": [
        {
          "old": "ptr addrspace(6) inttoptr (i64 256 to ptr addrspace(6)), ptr addrspace(1) %b",
          "new": "ptr addrspace(6) inttoptr (i64 260 to ptr addrspace(6)), ptr addrspace(1) %b"
        }
      ]
    },
    {
      "name": "register_store_misaligned_ub",
      "ir": "../vadd.ll",
      "case": "../vadd.case.json",
      "expect_asc_status": "error",
      "replacements": [
        {
          "old": "@llvm.hivm.vstsx1.v64f32(<64 x float> %sum, ptr addrspace(6) inttoptr (i64 512 to ptr addrspace(6))",
          "new": "@llvm.hivm.vstsx1.v64f32(<64 x float> %sum, ptr addrspace(6) inttoptr (i64 516 to ptr addrspace(6))"
        }
      ]
    },
    {
      "name": "gm_output_overflow",
      "ir": "../vadd.ll",
      "case": "../vadd.case.json",
      "expect_asc_status": "error",
      "case_overrides": {
        "buffers": {
          "out": {
            "size": 16
          }
        }
      }
    },
    {
      "name": "wait_without_matching_set",
      "ir": "../vadd.ll",
      "case": "../vadd.case.json",
      "expect_asc_status": "error",
      "replacements": [
        {
          "old": "  call void @llvm.hivm.SET.FLAG.IMM(i64 4, i64 1, i64 0)\n",
          "new": ""
        }
      ]
    }
  ],
